---
import '../styles/global.css';

const row1 = [
  { src: '/smithsonian.jpg', alt: 'NIMH Oral Presentation', label: 'NIMH/NIH Selected Lightning Talk Speaker' },
  { src: '/art.jpg', alt: 'Art and Science', label: '3rd Place Art Winner! "Waves of Consciousness"' },
  { src: '/poster.jpg', alt: 'ASSC Presentation', label: 'Oral presentation at NIMH/NIH' },
  { src: '/talk.jpg', alt: 'Poster Presentation', label: 'Advocating for environmentally friendly infrastructure' },
  { src: '/oxford.jpg', alt: 'Oxford', label: 'Perception of iridescence at the University of Oxford' },
  { src: '/narcan.jpg', alt: 'Narcan', label: '' },
];

// Dates confirmed against Plyfaa's records, 2026-07-29. Ordered by amount, descending.
const funding = [
  { name: 'NIH Postbaccalaureate IRTA',            year: 'Jun 2024 – Jun 2026', amount: '$94,300' },
  { name: 'NIH MARC Traineeship',                  year: 'Apr 2023',            amount: '$22,338' },
  { name: 'Simons Foundation Shenoy Fellowship',   year: 'Aug 2023',            amount: '$11,598' },
  { name: 'UK Rank Prize Vacation Grant',          year: 'May 2023',            amount: '$5,500'  },
  { name: 'UC Davis Experiential Learning Grant',  year: 'Jun 2023',            amount: '$3,600'  },
  { name: 'NIMH Trainee Travel Award',             year: 'Sep 2025',            amount: '$1,000'  },
  { name: "UC Davis Provost's Undergraduate Fellowship", year: 'Jun 2023',      amount: '$808'    },
  { name: 'ASSC Early Career Travel Award',        year: 'May 2025',            amount: '$500'    },
  { name: 'UC Davis Undergraduate Travel Award',   year: 'Jan 2024',            amount: '$500'    },
];

// Hero recommendations — add more entries and they stack; `quote` and `note` are both optional.
const recommendations = [
  {
    title:  'Talking to Strangers',
    author: 'Malcolm Gladwell',
    href:   'https://www.goodreads.com/en/book/show/43848929-talking-to-strangers',
    note:   'This book has had so much influence over how I communicate. Trusting people is not a flaw.',
    quote:  'To assume the best about another is the trait that has created modern society. Those ' +
            'occasions when our trusting nature gets violated are tragic. But the alternative — to ' +
            'abandon trust as a defense against predation and deception — is worse.',
  },
  {
    title:  'The Danger of a Single Story',
    author: 'Chimamanda Ngozi Adichie',
    href:   'https://youtu.be/D9Ihs241zeg',
    note:   'I was 14 when I first watched this, and it has stayed with me ever since. I hope to meet ' +
            'Adichie in person one day. She has shaped so much of how I listen and how much I trust ' +
            'anything that describes a person in a single sentence.',
    quote:  'I would like to end with this thought: that when we reject the single story, when we ' +
            'realize that there is never a single story about any place, we regain a kind of paradise.',
  },
];

// const row2 = [
//   { src: '/Hawaii Pacific Neuroscience summer cohort.jpg', alt: 'Hawaii Pacific Neuroscience summer cohort', label: 'Hawaii Pacific Neuroscience summer cohort' },
//   { src: '/SFIM lab dinner.jpeg', alt: 'SFIM lab dinner', label: 'SFIM lab dinner' },
//   { src: '/Summer internship social in Oahu.jpg', alt: 'Summer internship social in Oahu', label: 'Summer internship social in Oahu' },
//   { src: '/Summer_internship_in_Oahu.jpg', alt: 'Summer internship in Oahu', label: 'Summer internship in Oahu' },
//   { src: '/graduation.jpeg', alt: 'Graduation', label: 'Graduation' },
// ];
---

<!-- Plyfaa Suwanamalik-Murphy -->

<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Plyfaa Suwanamalik-Murphy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet"/>
  </head>

  <body>

    <!-- NAV -->
    <nav id="nav">
      <div class="nav-logo">
        <a href="#about" class="nav-logo-name">Plyfaa Suwanamalik-Murphy <span class="nav-logo-tagline">~ Eye Signals &amp; Fatigue Detection</span></a>
        <span class="nav-logo-thai-row">
          <span class="nav-logo-thai">ปลายฟ้า</span>
          <span class="nav-logo-phonetic">/ˈplaɪfɑː/</span>
          <button type="button" class="pronunciation-btn" id="pronunciation-btn" aria-label="Play pronunciation of Plyfaa">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          </button>
          <audio id="thai-name-audio" src="/name_pronunciation.m4a" preload="metadata"></audio>
        </span>
        <div class="nav-icons" aria-label="Contact">
        <a href="mailto:plysuwana@gmail.com" aria-label="Email" class="nav-icon nav-icon--email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/plyfaa-murphy/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="nav-icon nav-icon--linkedin">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 3H3.55A.55.55 0 0 0 3 3.55v16.9c0 .3.25.55.55.55h16.9a.55.55 0 0 0 .55-.55V3.55A.55.55 0 0 0 20.45 3zM8.34 18.34H5.67V9.67h2.67v8.67zM7 8.5a1.55 1.55 0 1 1 0-3.1 1.55 1.55 0 0 1 0 3.1zm11.34 9.84h-2.67v-4.42c0-1.05-.02-2.4-1.46-2.4-1.46 0-1.69 1.14-1.69 2.32v4.5H9.86V9.67h2.56v1.18h.04c.36-.67 1.22-1.38 2.52-1.38 2.7 0 3.2 1.78 3.2 4.08v4.79z"/></svg>
        </a>
        <a href="https://github.com/plyfaa" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="nav-icon nav-icon--github">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.95-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.7.41.35.78 1.05.78 2.12 0 1.53-.01 2.77-.01 3.14 0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <a href="https://scholar.google.com/citations?user=TCRiqYcAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar" class="nav-icon nav-icon--scholar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.749-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
        </a>
        <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" aria-label="Curriculum Vitae" class="nav-icon nav-icon--with-text">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
          <span>CV</span>
        </a>
        </div>
      </div>
      <ul class="nav-links">
        <li><a href="#shipped">Shipped</a></li>
        <li><a href="#research">Research</a></li>
        <li><a href="#funding">Funding</a></li>
      </ul>
    </nav>

    <!-- ABOUT: Bio + photo -->
    <section id="about">
<div class="about-text-body">
          <p class="about-lede">I'm fascinated by the eyes and what they reveal about our perception.</p>
          <p class="about-deck">
            I spent four years measuring it at NIH, Oxford, and UC Davis (+ a lot of other places).
            Now I'm building
            <a href="https://www.thisisnoddr.com/" class="about-highlight" target="_blank" rel="noopener noreferrer">Noddr</a>
            into the safety glasses industrial crews already wear.
          </p>

          <div class="hero-rec">
            <p class="hero-rec-label">Things I always highly highly highly recommend dedicating time to</p>
            {recommendations.map(r => (
              <div class="rec-item">
                <p class="rec-title">
                  <a href={r.href} class="about-highlight" target="_blank" rel="noopener noreferrer">{r.title}</a>
                  <span class="rec-author">{r.author}</span>
                </p>
                {r.note && <p class="rec-note">{r.note}</p>}
                {r.quote && <blockquote class="rec-quote">{r.quote}</blockquote>}
              </div>
            ))}
          </div>
      </div>
      <div class="bio-stack">
        <div class="bio-photo-block">
          <span class="bio-photo-hint" aria-hidden="true">pssst! bring your cursor over the picture <span class="hint-eyes">&#128064;</span></span>
          <div class="bio-photo-wrapper">
            <img src="/picnic.jpeg" alt="Plyfaa Suwanamalik-Murphy" class="about-photo bio-photo"/>
            {/* Hover easter egg: cartoon eyes pinned to her actual eyes (measured off the source
                frame as percentages, so they track the photo at any size) and a little message. */}
            <span class="eye eye--l" aria-hidden="true"><span class="eye-lid"><svg class="eye-shape" viewBox="0 0 100 70" preserveAspectRatio="none"><path d="M1,35 C20,5 80,5 99,35 C80,65 20,65 1,35 Z"/></svg><span class="eye-pupil"></span></span></span>
            <span class="eye eye--r" aria-hidden="true"><span class="eye-lid"><svg class="eye-shape" viewBox="0 0 100 70" preserveAspectRatio="none"><path d="M1,35 C20,5 80,5 99,35 C80,65 20,65 1,35 Z"/></svg><span class="eye-pupil"></span></span></span>
            <span class="photo-msgs" aria-hidden="true">
              <span class="photo-message">caught you looking hehe</span>
              <span class="photo-affirm">this is your reminder that you are unstoppable</span>
            </span>
          </div>
        </div>
      </div>
    </section>

{/* GALLERY: two scrolling rows. commented out for now
    <section id="gallery">
      <p class="section-tag reveal gallery-tag">From the Lab</p>
      <div class="gallery-marquee reveal">
        <div class="gallery-row">
          <div class="gallery-track scroll-left">
            {[...row1, ...row1].map(p => (
              <figure class="gallery-item">
                <img src={p.src} alt={p.alt} />
                {p.label && <figcaption class="gallery-item-label">{p.label}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
        <div class="gallery-row">
          <div class="gallery-track scroll-right">
            {[...row2, ...row2].map(p => (
              <figure class="gallery-item">
                <img src={p.src} alt={p.alt} />
                {p.label && <figcaption class="gallery-item-label">{p.label}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
    */}

    <!-- SHIPPED -->
    <section id="shipped">
      <p class="section-tag reveal">Shipped</p>

      <ol class="shipped-list">
        <li class="shipped-item reveal">
          <div class="shipped-head">
            <h3 class="shipped-name">Nudge</h3>
            <a href="https://try-nudge.com" class="shipped-link" target="_blank" rel="noopener noreferrer">try-nudge.com <span class="shipped-arrow" aria-hidden="true">&#8599;</span></a>
          </div>
          <p class="shipped-body">
            Browser focus tool. MediaPipe FaceMesh gaze tracking, three-step calibration, 10-second
            distraction threshold. React, Vite, TypeScript, no server.
          </p>
        </li>

        <li class="shipped-item reveal">
          <div class="shipped-head">
            <h3 class="shipped-name">Lasso</h3>
            <a href="https://apps.apple.com/us/app/lasso-price-drop-tracker/id6761538243" class="shipped-link" target="_blank" rel="noopener noreferrer">App Store <span class="shipped-arrow" aria-hidden="true">&#8599;</span></a>
          </div>
          <p class="shipped-body">Price-drop tracker. Live on the iOS App Store.</p>
        </li>

        <li class="shipped-item reveal">
          <div class="shipped-head">
            <h3 class="shipped-name">3rdi</h3>
          </div>
          <p class="shipped-body">
            Meditation app, full build. React Native, Expo. Freelance designer-engineer.
          </p>
        </li>
      </ol>
    </section>

    <!-- RESEARCH -->
    <section id="research">
      <p class="section-tag reveal">Research</p>

      <ol class="research-list">
        <li class="research-item reveal">
          <div class="research-head">
            <h3 class="research-org"><a href="https://www.nih.gov" class="research-org-link" target="_blank" rel="noopener noreferrer">NIH / NIMH</a>, Laboratory of Brain and Cognition</h3>
            <span class="research-when">2024&ndash;2026</span>
          </div>
          <p class="research-body">
            Built ocular analysis pipeline in MATLAB: pupil and gaze extraction, blink interpolation,
            microsaccade detection, event epoching. MEG preprocessing with ICA and artifact rejection,
            automated on Slurm HPC.
            <span class="research-pi">With <a href="https://fim.nimh.nih.gov/" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Peter Bandettini</a>.</span>
          </p>
        </li>

        <li class="research-item reveal">
          <div class="research-head">
            <h3 class="research-org"><a href="https://ucdavis.edu" class="research-org-link" target="_blank" rel="noopener noreferrer">UC Davis</a> Neuroprosthetics Lab, <a href="https://www.simonsfoundation.org" class="research-org-link" target="_blank" rel="noopener noreferrer">Simons Foundation</a> Fellow</h3>
            <span class="research-when">2023&ndash;2024</span>
          </div>
          <p class="research-body">
            Spike-sorting pipeline in Python isolating single neurons from four 64-channel arrays
            implanted in a participant with ALS.
            <span class="research-pi">With <a href="https://neuroprosthetics.science/" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Sergey Stavisky</a>.</span>
          </p>
        </li>

        <li class="research-item reveal">
          <div class="research-head">
            <h3 class="research-org"><a href="https://www.psy.ox.ac.uk/" class="research-org-link" target="_blank" rel="noopener noreferrer">University of Oxford</a>, Perception Lab</h3>
            <span class="research-when">2023</span>
          </div>
          <p class="research-body">
            Perception paradigms in PsychToolbox, MATLAB visualization pipelines for iridescent stimuli.
            <span class="research-pi">With <a href="https://www.psy.ox.ac.uk/people/hannah-smithson" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Hannah Smithson</a>.</span>
          </p>
        </li>

        <li class="research-item reveal">
          <div class="research-head">
            <h3 class="research-org"><a href="https://ucdavis.edu" class="research-org-link" target="_blank" rel="noopener noreferrer">UC Davis</a>, Bachelor's Cognitive Science</h3>
            <span class="research-when">Completed in two years</span>
          </div>
          <p class="research-body">Published abstract in <a href="https://www.neurology.org/doi/abs/10.1212/WNL.0000000000202503" class="about-highlight" target="_blank" rel="noopener noreferrer"><em>Neurology</em></a> as an undergraduate.</p>
        </li>

        <li class="research-item reveal">
          <div class="research-head">
            <h3 class="research-org"><a href="https://ucsd.edu" class="research-org-link" target="_blank" rel="noopener noreferrer">UC San Diego</a></h3>
            <span class="research-when">Incoming PhD</span>
          </div>
          <p class="research-body">
            Admitted to <a href="https://bradylab.ucsd.edu" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Timothy Brady's Vision and Memory Lab</a>.
          </p>
        </li>
      </ol>

      <p class="research-note reveal">
        11 conference presentations, 2023&ndash;2026, several as spoken talks. First-author talks at the
        Vision Sciences Society and the Smithsonian Institution, slots that usually go to PhD students,
        postdocs, and PIs. $140K in competitive research funding across nine awards.
      </p>
    </section>

    <!-- FUNDING -->
    <section id="funding">
      <p class="section-tag reveal">Funding</p>
      <ul class="funding-list">
        {funding.map(f => (
          <li class="funding-item reveal">
            <span class="funding-name">{f.name}</span>
            <span class="funding-leader" aria-hidden="true"></span>
            <span class="funding-meta">
              <span class="funding-year">{f.year}</span>
              <span class="funding-amount">{f.amount}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p class="footer-credit">
        Designed in <a href="https://figma.com" class="footer-highlight" target="_blank" rel="noopener noreferrer">Figma</a>, built with
        <a href="https://astro.build" class="footer-highlight" target="_blank" rel="noopener noreferrer">Astro</a>, set in
        <a href="https://fonts.google.com/specimen/Cormorant+Garamond" class="footer-highlight" target="_blank" rel="noopener noreferrer">Cormorant Garamond</a> &amp;
        <a href="https://fonts.google.com/specimen/EB+Garamond" class="footer-highlight" target="_blank" rel="noopener noreferrer">EB Garamond</a>,
        and deployed on <a href="https://pages.github.com" class="footer-highlight" target="_blank" rel="noopener noreferrer">GitHub Pages</a>.
      </p>
    </footer>

<style is:global>
      /* ── DESIGN TOKENS ("this is my color") ── */
      :root {
        /* ── fonts ───────────────────────────────────────── */
        --serif:        'Cormorant Garamond', 'EB Garamond', Georgia, 'Times New Roman', serif;
        --serif-body:   'EB Garamond', Georgia, 'Times New Roman', serif;
        --sans:         'EB Garamond', Georgia, 'Times New Roman', serif;
        --mono:         'EB Garamond', Georgia, 'Times New Roman', serif;

        /* ── colors (warm editorial neutral colors) ───────────── */
        --bg:           #FFFFFF;
        --surface:      #FCEEE2;
        --text:         #1A1A1A;
        --muted:        rgba(26,26,26,0.55);
        --border:       rgba(26,26,26,0.12);
        --link:         #1A1A1A;
        --accent:       #D6826E;
        --dark-accent:  #0B125F;
        --light-accent: #FCEEE2;
        --blue:         #D6826E;
        --blue-dim:     rgba(214,130,110,0.5);

        /* ── layout & rhythm ────────────────────────────── */
        --maxw:         680px;            /* readable measure for body */
        --section-maxw: 900px;            /* slightly wider container for sections */
        --space-1:      8px;
        --space-2:      16px;
        --space-3:      24px;
        --space-4:      40px;
        --space-5:      64px;
        --space-6:      96px;
        --space-7:      128px;            /* generous breathing room above sections */
        --radius:       0;

        /* ── type sizes (editorial scale) ───────────────── */
        --text-base:    18px;
        --text-sm:      14px;
        --leading-body: 1.7;
        --leading-tight:1.2;
        --heading-section: clamp(28px, 3.4vw, 40px);
        --heading-display: clamp(32px, 4vw, 48px);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--serif-body); background: var(--bg); color: var(--text); font-size: var(--text-base); line-height: var(--leading-body); font-weight: 400; letter-spacing: 0; overflow-x: hidden; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
      @media (min-width: 1024px) { html { zoom: 0.85; } }

      /* ── NAV ── */
      nav {
        position: static; z-index: 100;
        display: flex; flex-direction: row; justify-content: space-between; align-items: baseline;
        gap: clamp(16px, 3vw, 48px);
        padding: clamp(12px, 2vw, 24px) clamp(20px, 5vw, 64px); border-bottom: 1px solid var(--border);
        background: transparent;
      }
      .nav-logo { display: inline-flex; flex-direction: column; gap: 2px; color: var(--text); text-decoration: none; line-height: 1.05; }
      .nav-logo-name { font-family: var(--serif); font-size: clamp(28px, 2.8vw, 42px); font-weight: 400; letter-spacing: 0; white-space: nowrap; color: var(--text); text-decoration: none; }
      .nav-logo-tagline { font-style: italic; color: var(--muted); }
      .nav-logo-thai-row { display: inline-flex; align-items: center; gap: 6px; }
      .nav-logo-thai { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 1.4vw, 22px); color: var(--accent); letter-spacing: 0; }
      .nav-logo-phonetic { font-family: var(--serif-body); font-style: normal; font-size: clamp(16px, 1.4vw, 22px); color: var(--muted); letter-spacing: 0; }
      .pronunciation-btn { background: none; border: 0; padding: 2px; margin: 0; cursor: pointer; color: var(--text); display: inline-flex; align-items: center; justify-content: center; line-height: 0; }
      .pronunciation-btn:hover { color: var(--accent); }
      .pronunciation-btn svg { width: clamp(18px, 1.4vw, 22px); height: clamp(18px, 1.4vw, 22px); display: block; }
      #thai-name-audio { display: none; }
      /* contact icons live inside .nav-logo, stacked under the Thai row */
      .nav-icons { display: flex; align-items: center; gap: clamp(10px, 1.2vw, 18px); margin-top: 8px; }
      .nav-icon { display: inline-flex; align-items: center; justify-content: center; gap: 6px; color: var(--accent); line-height: 0; text-decoration: none; }
      .nav-icon:hover { opacity: 0.75; }
      .nav-icon svg { width: clamp(20px, 1.8vw, 26px); height: clamp(20px, 1.8vw, 26px); display: block; }
      .nav-icon--with-text { line-height: 1; }
      .nav-icon--with-text span { font-family: var(--serif-body); font-style: normal; font-size: clamp(15px, 1.2vw, 18px); letter-spacing: 0; }
      .nav-links { display: flex; gap: clamp(18px, 2.4vw, 34px); list-style: none; }
      .nav-links a { font-family: var(--serif-body); font-size: clamp(18px, 1.7vw, 26px); letter-spacing: 0; color: var(--text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; text-decoration-color: var(--border); white-space: nowrap; }
      .nav-links a:hover { color: var(--accent); text-decoration-color: var(--accent); }

      /* ── SECTION BASE ── */
      section { max-width: var(--section-maxw); margin-left: auto; margin-right: auto; padding: var(--space-7) clamp(20px, 5vw, 64px) var(--space-6); border-bottom: 1px solid var(--border); }
      .section-tag { font-family: var(--serif); font-size: var(--heading-section); font-weight: 400; letter-spacing: 0; color: var(--text); margin-bottom: var(--space-5); display: flex; align-items: center; gap: 16px; }
      /* removed the decorative blue line next to section headers */
