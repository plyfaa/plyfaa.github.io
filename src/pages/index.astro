        14%, 20%  { transform: scaleY(0.06); }
        28%, 36%  { transform: scaleY(1); }
        44%, 50%  { transform: scaleY(0.06); }
        58%, 100% { transform: scaleY(1); }
      }
      @keyframes blink-idle {
        0%, 90%, 100% { transform: scaleY(1); }
        94%, 96%      { transform: scaleY(0.06); }
