        display: flex; flex-direction: row; align-items: flex-start; gap: clamp(32px, 4.5vw, 76px);
        max-width: min(1600px, 92vw); margin-left: auto; margin-right: auto;
      }
      #about::before {
        content: ''; position: absolute; z-index: -2; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw;
        background: var(--bg);
