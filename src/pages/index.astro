      .eye-pupil::after {
        content: ''; position: absolute; left: 20%; top: 16%; width: 34%; aspect-ratio: 1;
        background: #FFFDF8; border-radius: 50%;
      }
      .bio-photo-wrapper:hover .eye { opacity: 1; transform: translate(-50%, -50%) rotate(22deg) scale(1); }
      /* blink only while hovered, so the animation isn't running invisibly the whole time */
      /* two quick blinks the moment the eyes land, then settle into a slow spaced-out rhythm.
