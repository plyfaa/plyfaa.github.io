      .about-lede {
        font-family: var(--serif); font-size: clamp(30px, 3.7vw, 50px); font-weight: 400;
        line-height: 1.12; letter-spacing: -0.005em; color: var(--text);
        margin-bottom: var(--space-3); max-width: 15em; text-wrap: balance;
      }
      .about-deck {
