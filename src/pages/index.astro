      }
      /* ── HERO RECOMMENDATIONS ──
         Third tier under lede/deck, and it fills the space beside the photo's lower half. */
      .hero-rec {
        margin-top: var(--space-4); padding-top: var(--space-3);
        border-top: 1px solid var(--border); max-width: 34em;
      }
      .hero-rec-label {
