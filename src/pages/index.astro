---
import '../styles/global.css';

// Content sourced from cv.pdf and the previous version of this page. Each section renders
// from one of the arrays below, so most edits are data-only.

const contact = [
  { label: 'LinkedIn',       href: 'https://www.linkedin.com/in/plyfaa-murphy/' },
  { label: 'GitHub',         href: 'https://github.com/plyfaa' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=TCRiqYcAAAAJ&hl=en' },
  { label: 'CV (PDF)',       href: '/cv.pdf' },
];

const research = [
  {
    when: '2024 – 2026',
    org: 'National Institutes of Health (NIMH)',
    orgHref: 'https://www.nih.gov',
    unit: 'Laboratory of Brain and Cognition, Section on Functional Imaging Methods',
    role: 'Postbaccalaureate Research Fellow (IRTA)',
    body: 'Built an ocular analysis pipeline in MATLAB: pupil and gaze extraction, blink interpolation, ' +
          'microsaccade detection, and event epoching. MEG preprocessing with ICA and artifact rejection, ' +
          'automated on Slurm HPC. Recruited 30+ participants; collected fMRI and behavioral data.',
    pi: [{ name: 'Dr. Peter Bandettini', href: 'https://fim.nimh.nih.gov/' }],
  },
  {
    when: '2023 – 2024',
    org: 'UC Davis, Department of Neurological Surgery',
    orgHref: 'https://ucdavis.edu',
    unit: 'Neuroprosthetics Lab',
    role: 'Simons Foundation Shenoy Fellow',
    body: 'Developed a spike-sorting pipeline in Python isolating single neurons from four 64-channel ' +
          'microelectrode arrays implanted in a participant with ALS, as part of a speech BCI study.',
    pi: [{ name: 'Dr. Sergey Stavisky', href: 'https://neuroprosthetics.science/' }],
  },
  {
    when: '2023',
    org: 'University of Oxford, Department of Experimental Psychology',
    orgHref: 'https://www.psy.ox.ac.uk/',
    unit: 'Oxford Perception Lab',
    role: 'Visiting Research Scholar',
    body: 'Piloted perception paradigms in PsychToolbox and built MATLAB visualization pipelines for ' +
          'iridescent stimuli.',
    pi: [{ name: 'Dr. Hannah Smithson', href: 'https://www.psy.ox.ac.uk/people/hannah-smithson' }],
  },
  {
    when: '2022 – 2023',
    org: 'UC Davis, Center for Mind & Brain',
    orgHref: 'https://ucdavis.edu',
    unit: 'Visual Cognition Lab',
    role: 'Research Assistant',
    body: 'Built a 40+ scene image dataset for studying how scene context shapes visual attention; ran ' +
          'eye-tracking experiments and annotated 200+ stimuli for object depth.',
    pi: [{ name: 'Dr. John Henderson', href: 'https://viscoglab.ucdavis.edu/' }],
  },
  {
    when: '2022 – 2023',
    org: 'UC Davis, Center for Mind & Brain',
    orgHref: 'https://ucdavis.edu',
    unit: 'Neural Mechanisms of Attention + Cognitive Neurolinguistics Labs',
    role: 'Research Assistant',
    body: 'Collected and analyzed 64-channel EEG investigating audiovisual speech processing, including ' +
          'ERP analyses of N400 responses.',
    pi: [
      { name: 'Dr. George Mangun', href: 'https://mangunlab.ucdavis.edu/' },
      { name: 'Dr. David Corina',  href: 'https://dpcorina.faculty.ucdavis.edu/' },
    ],
  },
  {
    when: '2022',
    org: 'Hawaiʻi Pacific Neuroscience',
    orgHref: 'https://hawaiineuroscience.com/',
    role: 'Summer Intern',
    body: 'Analyzed clinical records and psychiatric outcomes in multiple sclerosis using nonparametric ' +
          'and categorical statistics. Published as an abstract in Neurology.',
    pi: [{ name: 'Drs. Jason Viereck, Kore Liow & Shin Chang' }],
  },
  {
    when: '2022',
    org: 'University of Hawaiʻi at Mānoa',
    unit: 'Brain & Behavior Lab + Intergroup Social Perception Lab',
    role: 'Summer Research Assistant',
    body: 'Assembled EEG acquisition systems for neurological rehabilitation research and analyzed ' +
          'demographic effects on face recognition with mixed-design models.',
    pi: [
      { name: 'Dr. Jonas Vibell',    href: 'https://brainandbehaviorlab.com/' },
      { name: 'Dr. Kristin Pauker',  href: 'https://manoa.hawaii.edu/isplab/' },
    ],
  },
];

const ME = 'Suwanamalik-Murphy, P.';
const publications = [
  {
    authors: 'Chang, S., Suwanamalik-Murphy, P., Okazaki, J., Roy, D., Matsunaga, M., Goo, C., Carrazana, E., Viereck, J., & Liow, K.',
    year: '2023',
    title: 'Investigating the prevalence of psychiatric disorders in multiple sclerosis with autoimmune comorbidities (P5-3.008).',
    venue: 'Neurology, 100(17 Suppl 2).',
    href: 'https://doi.org/10.1212/WNL.0000000000202503',
  },
];

const talks = [
  { authors: 'Suwanamalik-Murphy, P., et al.',
    date: '2026', title: 'The physiological correlates of conscious and unconscious visual and auditory processing: An MEG and eye-tracking study.',
    venue: 'Vision Sciences Society Annual Meeting, St. Pete Beach, FL.',
    href: 'https://fim.nimh.nih.gov/presentations/physiological_correlates_of_conscious_and_unconscious_visual_and_auditory_processing/', linkText: 'Presentation details' },
  { authors: 'Suwanamalik-Murphy, P., Gobo, V., Gonzalez-Castillo, J., Benitez-Andonegui, A., Bandettini, P., & Kronemer, S.',
    date: '2025', title: 'Neural dynamics of visual consciousness and awareness.',
    venue: 'Society for Neuroscience Annual Meeting, San Diego, CA. Accepted oral presentation; not presented due to the government shutdown.' },
  { authors: 'Suwanamalik-Murphy, P.',
    date: '2025', title: 'The eyes know what the brain hears.',
    venue: 'NIMH IRP Fellows’ Scientific Training Day, Washington, D.C. Selected lightning talk, one of two postbacs chosen.' },
  { authors: 'Suwanamalik-Murphy, P., Gobo, V., Gonzalez-Castillo, J., Benitez-Andonegui, A., Bandettini, P., & Kronemer, S.',
    date: '2025', title: 'Examining how spontaneous eye measures indicate conscious and unconscious sensory neural processing.',
    venue: 'NIMH IRP Fellows’ Scientific Training Day, Washington, D.C.' },
  { authors: 'Suwanamalik-Murphy, P.',
    date: '2025', title: 'What the eyes reveal about the brain.',
    venue: 'NIMH Three Minute Talk Competition, Bethesda, MD.' },
  { authors: 'Suwanamalik-Murphy, P., Gobo, V., Gonzalez-Castillo, J., Benitez-Andonegui, A., Bandettini, P., & Kronemer, S.',
    date: '2025', title: 'Investigating eye metrics as an indicator of sensory neural processing, behavior, and conscious perception.',
    venue: 'Association for the Scientific Study of Consciousness, Heraklion, Crete, Greece.' },
  { authors: 'Suwanamalik-Murphy, P., Gobo, V., Gonzalez-Castillo, J., Benitez-Andonegui, A., Bandettini, P., & Kronemer, S.',
    date: '2025', title: 'How brain states associated with spontaneous pupillary fluctuations alter conscious and unconscious sensory neural processing.',
    venue: 'NIH Postbac Poster Day, Bethesda, MD.' },
  { authors: 'Suwanamalik-Murphy, P., Shehabi, S., Laurie, N., Pierotti, E., & Corina, D.',
    date: '2023', title: 'The impact of audiovisual cues on speech recognition: An ERP study.',
    venue: 'UC Davis Undergraduate Research Conference, Davis, CA.' },
  { authors: 'Chang, S., Suwanamalik-Murphy, P., Okazaki, J., Roy, D., Goo, C., Liow, K., Viereck, J., & Carrazana, E.',
    date: '2023', title: 'Investigating the prevalence of psychiatric disorders in multiple sclerosis with autoimmune comorbidities.',
    venue: 'American Academy of Neurology Annual Meeting, Boston, MA.' },
  { authors: 'Shehabi, S., Suwanamalik-Murphy, P., Pierotti, E., & Corina, D.',
    date: '2023', title: 'An ERP study investigating the influence of audiovisual cues on speech recognition.',
    venue: 'Stanford University, Stanford, CA.' },
  { authors: 'Mason, T., Suwanamalik-Murphy, P., Tenorio, K., Diaz, S., Pauker, K., Gaither, S., Halim, M., Dunham, Y., & Olson, K.',
    date: '2023', title: 'Variability in the cross-race effect among geographically diverse White children.',
    venue: 'Society for Personality and Social Psychology Annual Convention, Atlanta, GA.' },
];

// `href`/`linkText` are optional; entries without them render the name only.
const projects = [
  { name: 'Nudge', href: 'https://try-nudge.com', linkText: 'try-nudge.com',
    body: 'Browser-based focus tool using webcam gaze tracking (MediaPipe FaceMesh) with three-step ' +
          'calibration and a 10-second distraction threshold.' },
  { name: 'Lasso',
    body: 'Price-drop tracker, iOS App Store.' },
  { name: 'Matches pls',
    body: 'Directory and map of free matchbooks in San Francisco, built in response to community demand on TikTok.' },
  { name: 'Rodeo Growth Fellow', href: 'https://rodeorodeorodeo.com/', linkText: 'rodeorodeorodeo.com',
    body: 'Created UGC content for Rodeo, founded by former Hinge executives. Drove 150K+ TikTok views in ' +
          'two weeks, starting with no prior social media experience.' },
  { name: 'Meditation app',
    body: 'Led visual design in Krea for a fairy-themed meditation app for a paid client.' },
];

const education = [
  { org: 'University of California, San Diego', detail: 'PhD student, Psychology (Cognitive and Vision Science emphasis)' },
  { org: 'University of California, Davis', detail: "Bachelor's, Cognitive Science · GPA 3.83" },
];

// Ordered by amount, descending.
const funding = [
  { name: 'NIH Postbaccalaureate Intramural Research Training Award', year: '2024 – 2026', amount: '$94,300' },
  { name: 'NIH Maximizing Access to Research Careers (MARC) Traineeship', year: '2023', amount: '$22,338' },
  { name: 'Simons Foundation Shenoy Undergraduate Research Fellowship', year: '2023', amount: '$11,598' },
  { name: 'UK Rank Prize Undergraduate Vacation Grant',                 year: '2023', amount: '$5,500'  },
  { name: 'UC Davis Experiential Learning Opportunity Grant',           year: '2023', amount: '$3,600'  },
  { name: 'NIMH Trainee Travel Award',                                  year: '2025', amount: '$1,000'  },
  { name: "UC Davis Provost's Undergraduate Fellowship",                year: '2023', amount: '$808'    },
  { name: 'ASSC Early Career Researcher Travel Award',                  year: '2025', amount: '$500'    },
  { name: 'UC Davis Undergraduate Travel Award',                        year: '2024', amount: '$500'    },
];

const service = [
  { when: '2025 – present', org: 'Naloxone Network', role: 'Community Health Outreach Volunteer', place: 'Washington, D.C.' },
  { when: '2023 – 2024',    org: 'Cognitive Science Student Association, UC Davis', role: 'Project Manager' },
  { when: '2023 – 2024',    org: 'The Aggie Transcript: Psychology', role: 'Treasurer & Senior Editor' },
  { when: '2020 – 2021',    org: 'San Francisco Youth Commission', role: 'Vice-Chair' },
];

// Splits an author string so the site owner's name can be bolded.
const splitAuthors = (s: string) => s.split(ME);
---

<!-- Plyfaa Suwanamalik-Murphy -->

<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Plyfaa Suwanamalik-Murphy · Cognitive Scientist</title>
    <meta name="description" content="Plyfaa Suwanamalik-Murphy: cognitive scientist studying what eye signals reveal about attention, alertness, and conscious perception. PhD student in Psychology at UC San Diego; former NIH postbaccalaureate fellow; building Avelis, Inc."/>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧠</text></svg>"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet"/>
  </head>

  <body>
    <div class="page">

      <!-- HEADER -->
      <header class="masthead">
        <div class="identity">
          <h1 class="name">Plyfaa Suwanamalik-Murphy</h1>
          <p class="name-thai"><span lang="th">ปลายฟ้า</span> <span class="phonetic">/ˈplaɪfɑː/</span></p>
          <p class="title">Cognitive scientist · Eye signals &amp; human state</p>
        </div>
        <div class="reach">
          <ul class="contact">
            {contact.map(c => (
              <li><a href={c.href} target="_blank" rel="noopener noreferrer">{c.label}</a></li>
            ))}
          </ul>
          {/* written out rather than linked, to keep the address away from scrapers */}
          <p class="emails">plysuwana [at] gmail [dot] com</p>
        </div>
      </header>

      <!-- ABOUT -->
      <section id="about">
        <h2 class="section-title">About</h2>
        <div class="about">
          <img src="/picnic.jpeg" alt="Portrait of Plyfaa Suwanamalik-Murphy" class="about-photo"/>
          <div class="about-text">
            <p>
              I study what the eyes reveal about cognitive state: attention, alertness, and conscious
              perception. Over four years of research at the National Institutes of Health, the University
              of Oxford, and UC Davis, I've built analysis pipelines for eye-tracking, MEG, EEG, and
              intracortical brain-computer interface (BCI) recordings.
            </p>
            <p>
              I'm a PhD student in Psychology at UC San Diego, in Dr. Timothy Brady's
              <a href="https://bradylab.ucsd.edu/" target="_blank" rel="noopener noreferrer">Vision and Memory Lab</a>.
              I'm also building <a href="https://www.avelistechnologies.com/" target="_blank" rel="noopener noreferrer">Avelis, Inc.</a>,
              which translates ocular physiology into machine-readable measures of human state.
            </p>
          </div>
        </div>
      </section>

      <!-- CURRENT -->
      <section id="current">
        <h2 class="section-title">Current</h2>
        <div class="entry">
          <p class="entry-when">2026 – present</p>
          <div class="entry-main">
            <h3 class="entry-org"><a href="https://ucsd.edu" target="_blank" rel="noopener noreferrer">University of California, San Diego</a></h3>
            <p class="entry-unit">Department of Psychology, <a href="https://bradylab.ucsd.edu/" target="_blank" rel="noopener noreferrer">UCSD Vision and Memory Lab</a></p>
            <p class="entry-role">PhD Student</p>
            <p class="entry-pi">PI: <a href="https://bradylab.ucsd.edu/" target="_blank" rel="noopener noreferrer">Dr. Timothy Brady</a></p>
          </div>
        </div>
        <div class="entry">
          <p class="entry-when">Present</p>
          <div class="entry-main">
            <h3 class="entry-org"><a href="https://www.avelistechnologies.com/" target="_blank" rel="noopener noreferrer">Avelis, Inc.</a></h3>
            <p class="entry-unit">Human-state sensing</p>
            <p class="entry-body">
              Early warning for declining alertness and performance in safety-critical settings through
              eye-based sensing.
            </p>
          </div>
        </div>
      </section>

      <!-- RESEARCH -->
      <section id="research">
        <h2 class="section-title">Research Experience</h2>
        {research.map(r => (
          <div class="entry">
            <p class="entry-when">{r.when}</p>
            <div class="entry-main">
              <h3 class="entry-org">
                {r.orgHref ? <a href={r.orgHref} target="_blank" rel="noopener noreferrer">{r.org}</a> : r.org}
              </h3>
              {r.unit && <p class="entry-unit">{r.unit}</p>}
              <p class="entry-role">{r.role}</p>
              <p class="entry-body">{r.body}</p>
              <p class="entry-pi">
                PI: {r.pi.map((p, i) => (
                  <>{i > 0 && ', '}{p.href ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}</>
                ))}
              </p>
            </div>
          </div>
        ))}
      </section>

      <!-- PUBLICATIONS & PRESENTATIONS -->
      <section id="publications">
        <h2 class="section-title">Publications &amp; Presentations</h2>

        <h3 class="subsection-title">Published Abstracts</h3>
        <ol class="refs">
          {publications.map(p => (
            <li>
              {splitAuthors(p.authors).map((part, i) => <>{i > 0 && <strong>{ME}</strong>}{part}</>)}
              {' '}({p.year}). {p.title} <em>{p.venue}</em>{' '}
              <a href={p.href} target="_blank" rel="noopener noreferrer">DOI</a>
            </li>
          ))}
        </ol>

        <h3 class="subsection-title">Oral Presentations</h3>
        <ol class="refs">
          {talks.map(t => (
            <li>
              {splitAuthors(t.authors).map((part, i) => <>{i > 0 && <strong>{ME}</strong>}{part}</>)}
              {' '}({t.date}). <em>{t.title}</em> {t.venue}
              {t.href && <>{' '}<a href={t.href} target="_blank" rel="noopener noreferrer">{t.linkText}</a></>}
            </li>
          ))}
        </ol>
      </section>

      <!-- PROJECTS -->
      <section id="projects">
        <h2 class="section-title">Selected Projects (Outside the Lab)</h2>
        {projects.map(p => (
          <div class="project">
            <h3 class="entry-org">
              {p.name}
              {p.href && <a href={p.href} class="project-link" target="_blank" rel="noopener noreferrer">{p.linkText}</a>}
            </h3>
            <p class="entry-body">{p.body}</p>
          </div>
        ))}
      </section>

      <!-- EDUCATION -->
      <section id="education">
        <h2 class="section-title">Education</h2>
        {education.map(e => (
          <div class="edu">
            <h3 class="entry-org">{e.org}</h3>
            <p class="entry-unit">{e.detail}</p>
          </div>
        ))}
      </section>

      <!-- FUNDING -->
      <section id="funding">
        <h2 class="section-title">Fellowships &amp; Awards</h2>
        <table class="funding">
          <tbody>
            {funding.map(f => (
              <tr>
                <td class="funding-name">{f.name}</td>
                <td class="funding-year">{f.year}</td>
                <td class="funding-amount">{f.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- SERVICE -->
      <section id="service">
        <h2 class="section-title">Service &amp; Leadership</h2>
        {service.map(s => (
          <div class="entry entry--compact">
            <p class="entry-when">{s.when}</p>
            <div class="entry-main">
              <p><span class="entry-org-inline">{s.org}</span>, {s.role}{s.place && <span class="muted"> · {s.place}</span>}</p>
            </div>
          </div>
        ))}
      </section>

    </div>

<style is:global>
      :root {
        --font:      'Source Serif 4', Georgia, 'Times New Roman', serif;

        --bg:        #FFFFFF;
        --text:      #1F2328;
        --muted:     #5F6670;
        --rule:      #E3E5E8;
        --accent:    #9B1C1F;   /* deep crimson: links, headings */
        --accent-2:  #9B1C1F;   /* header rule */
        --accent-underline: rgba(155,28,31,0.35);

        --maxw:      880px;
        --when-col:  9.5rem;    /* date column in CV-style entries */
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font); font-size: 18px; line-height: 1.65; font-weight: 400;
        color: var(--text); background: var(--bg);
        -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
      }
      a { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--accent-underline); }
      a:hover { text-decoration-color: var(--accent); }
      strong { font-weight: 600; }
      .muted { color: var(--muted); }

      .page { max-width: var(--maxw); margin: 0 auto; padding: 72px 32px 48px; }

      /* ── HEADER ── */
      /* identity on the left, contact column on the right, bottoms aligned */
      .masthead {
        display: flex; justify-content: space-between; align-items: flex-end; gap: 32px;
        padding-bottom: 28px; border-bottom: 3px solid var(--accent-2);
      }
      .name { font-size: 44px; font-weight: 600; line-height: 1.1; letter-spacing: -0.01em; }
      .name-thai { margin-top: 6px; font-size: 18px; color: var(--muted); }
      .name-thai [lang="th"] { color: var(--accent); }
      .title { margin-top: 12px; font-size: 20px; }
      .reach { text-align: right; font-size: 16px; line-height: 1.6; flex-shrink: 0; }
      .contact { list-style: none; }
      .emails { margin-top: 4px; color: var(--muted); }

      /* ── ABOUT ── */
      .about { display: flex; gap: 36px; align-items: flex-start; }
      .about-photo { width: 200px; aspect-ratio: 1 / 1; object-fit: cover; object-position: center 25%; border-radius: 4px; flex-shrink: 0; display: block; }
      .about-text p + p { margin-top: 14px; }

      /* ── SECTIONS ── */
      section { padding-top: 48px; }
      .section-title {
        font-size: 26px; font-weight: 600; line-height: 1.25; letter-spacing: -0.005em;
        color: var(--accent); padding-bottom: 10px; margin-bottom: 24px; border-bottom: 1px solid var(--rule);
      }
      .subsection-title { font-size: 17px; font-weight: 600; margin: 28px 0 12px; }
      .subsection-title:first-of-type { margin-top: 0; }

      /* CV-style entry: date column on the left, details on the right */
      .entry { display: grid; grid-template-columns: var(--when-col) 1fr; gap: 0 24px; margin-bottom: 28px; }
      .entry:last-child { margin-bottom: 0; }
      .entry--compact { margin-bottom: 10px; }
      .entry-when { color: var(--muted); font-size: 16px; font-variant-numeric: tabular-nums; padding-top: 2px; }
      .entry-org { font-size: 19px; font-weight: 600; line-height: 1.35; }
      .entry-org a { color: inherit; text-decoration-color: var(--rule); }
      .entry-org a:hover { color: var(--accent); text-decoration-color: var(--accent); }
      .entry-org-inline { font-weight: 600; }
      .entry-unit { color: var(--text); }
      .entry-role { font-style: italic; color: var(--muted); }
      .entry-body { margin-top: 6px; }
      .entry-pi { margin-top: 4px; font-size: 16px; color: var(--muted); }

      /* ── REFERENCES ── */
      .refs { padding-left: 1.6em; }
      .refs li { margin-bottom: 12px; padding-left: 4px; font-size: 17px; }
      .refs li::marker { color: var(--muted); }

      /* ── PROJECTS ── */
      .project { margin-bottom: 22px; }
      .project:last-child { margin-bottom: 0; }
      .project-link { margin-left: 12px; font-size: 15px; font-weight: 400; color: var(--accent); text-decoration-color: var(--accent-underline); white-space: nowrap; }
      .project .entry-body { margin-top: 2px; }

      .edu + .edu { margin-top: 18px; }

      /* ── FUNDING ── */
      .funding { width: 100%; border-collapse: collapse; }
      .funding td { padding: 9px 0; border-bottom: 1px solid var(--rule); vertical-align: baseline; }
      .funding tr:last-child td { border-bottom: none; }
      .funding-year { color: var(--muted); font-size: 16px; white-space: nowrap; padding-left: 24px !important; text-align: right; font-variant-numeric: tabular-nums; }
      .funding-amount { white-space: nowrap; padding-left: 24px !important; text-align: right; font-variant-numeric: tabular-nums; }

      /* ── RESPONSIVE ── */
      @media (max-width: 700px) {
        body { font-size: 17px; }
        .page { padding: 40px 20px 32px; }
        .name { font-size: 32px; }
        .title { font-size: 18px; }
        /* contact block drops under the name; links go back to one wrapping row */
        .masthead { flex-direction: column; align-items: flex-start; gap: 18px; }
        .reach { text-align: left; }
        .contact { display: flex; flex-wrap: wrap; gap: 4px 20px; }
        .about { flex-direction: column; gap: 24px; }
        .about-photo { width: 160px; }
        section { padding-top: 40px; }
        /* date moves above the entry instead of taking a column */
        .entry { grid-template-columns: 1fr; }
        .entry-when { padding-top: 0; font-size: 15px; }
        .refs { padding-left: 1.1em; }
        .refs li { font-size: 16px; }
