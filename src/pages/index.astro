    <footer>
      <p class="footer-credit">
        Designed in <a href="https://figma.com" class="footer-highlight" target="_blank" rel="noopener noreferrer">Figma</a>, built with
        <a href="https://astro.build" class="footer-highlight" target="_blank" rel="noopener noreferrer">Astro</a>, set in
        <a href="https://fonts.google.com/specimen/Cormorant+Garamond" class="footer-highlight" target="_blank" rel="noopener noreferrer">Cormorant Garamond</a> &amp;
        <a href="https://fonts.google.com/specimen/EB+Garamond" class="footer-highlight" target="_blank" rel="noopener noreferrer">EB Garamond</a>,
        and deployed on <a href="https://pages.github.com" class="footer-highlight" target="_blank" rel="noopener noreferrer">GitHub Pages</a>.
      </p>
    </footer>

<style is:global>
      /* ── DESIGN TOKENS ("this is my color") ── */
      :root {
        /* ── fonts ───────────────────────────────────────── */
        --serif:        'Cormorant Garamond', 'EB Garamond', Georgia, 'Times New Roman', serif;
        --serif-body:   'EB Garamond', Georgia, 'Times New Roman', serif;
        --sans:         'EB Garamond', Georgia, 'Times New Roman', serif;
        --mono:         'EB Garamond', Georgia, 'Times New Roman', serif;

        /* ── colors (warm editorial neutral colors) ───────────── */
        --bg:           #FFFFFF;
        --surface:      #FCEEE2;
        --text:         #1A1A1A;
        --muted:        rgba(26,26,26,0.55);
        --border:       rgba(26,26,26,0.12);
        --link:         #1A1A1A;
        --accent:       #D6826E;
        --dark-accent:  #0B125F;
        --light-accent: #FCEEE2;
        --blue:         #D6826E;
        --blue-dim:     rgba(214,130,110,0.5);

        /* ── layout & rhythm ────────────────────────────── */
        --maxw:         680px;            /* readable measure for body */
        --section-maxw: 900px;            /* slightly wider container for sections */
        --space-1:      8px;
        --space-2:      16px;
        --space-3:      24px;
        --space-4:      40px;
        --space-5:      64px;
        --space-6:      96px;
        --space-7:      128px;            /* generous breathing room above sections */
        --radius:       0;

        /* ── type sizes (editorial scale) ───────────────── */
        --text-base:    18px;
        --text-sm:      14px;
        --leading-body: 1.7;
        --leading-tight:1.2;
        --heading-section: clamp(22px, 2.6vw, 30px);
        --heading-display: clamp(32px, 4vw, 48px);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--serif-body); background: var(--bg); color: var(--text); font-size: var(--text-base); line-height: var(--leading-body); font-weight: 400; letter-spacing: 0; overflow-x: hidden; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
      @media (min-width: 1024px) { html { zoom: 0.85; } }

      /* ── NAV ── */
      nav {
        position: static; z-index: 100;
        display: flex; flex-direction: row; justify-content: space-between; align-items: baseline;
        gap: clamp(16px, 3vw, 48px);
        padding: clamp(12px, 2vw, 24px) clamp(20px, 5vw, 64px); border-bottom: 1px solid var(--border);
        background: transparent;
      }
      .nav-logo { display: inline-flex; flex-direction: column; gap: 2px; color: var(--text); text-decoration: none; line-height: 1.05; }
      .nav-logo-name { font-family: var(--serif); font-size: clamp(28px, 2.8vw, 42px); font-weight: 400; letter-spacing: 0; white-space: nowrap; color: var(--text); text-decoration: none; }
      .nav-logo-tagline { font-style: italic; color: var(--muted); }
      .nav-logo-thai-row { display: inline-flex; align-items: center; gap: 6px; }
      .nav-logo-thai { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 1.4vw, 22px); color: var(--accent); letter-spacing: 0; }
      .nav-logo-phonetic { font-family: var(--serif-body); font-style: normal; font-size: clamp(16px, 1.4vw, 22px); color: var(--muted); letter-spacing: 0; }
      .pronunciation-btn { background: none; border: 0; padding: 2px; margin: 0; cursor: pointer; color: var(--text); display: inline-flex; align-items: center; justify-content: center; line-height: 0; }
      .pronunciation-btn:hover { color: var(--accent); }
      .pronunciation-btn svg { width: clamp(18px, 1.4vw, 22px); height: clamp(18px, 1.4vw, 22px); display: block; }
      #thai-name-audio { display: none; }
      .nav-icons { display: flex; align-items: center; gap: clamp(10px, 1.2vw, 18px); margin-top: 2px; }
      .nav-icon { display: inline-flex; align-items: center; justify-content: center; gap: 6px; color: var(--accent); line-height: 0; text-decoration: none; }
      .nav-icon:hover { opacity: 0.75; }
      .nav-icon svg { width: clamp(20px, 1.8vw, 26px); height: clamp(20px, 1.8vw, 26px); display: block; }
      .nav-icon--with-text { line-height: 1; }
      .nav-icon--with-text span { font-family: var(--serif-body); font-style: normal; font-size: clamp(15px, 1.2vw, 18px); letter-spacing: 0; }
      .nav-links { display: flex; gap: clamp(16px, 2.4vw, 32px); list-style: none; }
      .nav-links a { font-family: var(--serif-body); font-size: clamp(14px, 1.05vw, 17px); letter-spacing: 0; color: var(--text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--border); white-space: nowrap; }

      /* ── SECTION BASE ── */
      section { max-width: var(--section-maxw); margin-left: auto; margin-right: auto; padding: var(--space-7) clamp(20px, 5vw, 64px) var(--space-6); border-bottom: 1px solid var(--border); }
      .section-tag { font-family: var(--serif); font-size: var(--heading-section); font-weight: 400; letter-spacing: 0; color: var(--text); margin-bottom: var(--space-5); display: flex; align-items: center; gap: 16px; }
      /* removed the decorative blue line next to section headers */
      .section-tag::after { display: none; }

      /* ── ABOUT ── */
      #about {
        padding-top: var(--space-6); padding-bottom: var(--space-7);
        padding-left: clamp(12px, 2.5vw, 32px); padding-right: clamp(12px, 2.5vw, 32px);
        border-bottom: 1px solid var(--border); position: relative; color: var(--text);
        /* hero fills the viewport (minus nav) so the bottom border + footer sit at the fold, not a quarter up */
        min-height: calc(100svh - 5rem);
        display: flex; flex-direction: row; align-items: center; gap: var(--space-5);
        max-width: min(1600px, 92vw); margin-left: auto; margin-right: auto;
      }
      #about::before {
        content: ''; position: absolute; z-index: -2; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw;
        background: var(--bg);
      }
      #experiences, #gallery { border-bottom: none; }
      #gallery { padding-bottom: clamp(8px, 1vw, 16px); }
      .about-text-body { position: relative; flex: 1 1 0; min-width: 0; max-width: var(--maxw); margin: 0; border: none; padding: 0; background: transparent; z-index: 2; }
      .bio-stack { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: clamp(8px, 1.2vw, 14px); z-index: 2; order: -1; flex-shrink: 0; }
      .about-text-body .about-body:last-child { margin-bottom: 0; }
      .about-name { font-family: var(--serif); font-size: var(--heading-display); font-weight: 400; line-height: var(--leading-tight); letter-spacing: 0; color: var(--text); margin-bottom: var(--space-4); }
      .about-name em { font-style: italic; color: var(--accent); }
      .about-body { font-family: var(--serif-body); font-size: var(--text-base); font-weight: 400; color: var(--text); line-height: var(--leading-body); letter-spacing: 0; margin-bottom: var(--space-3); max-width: var(--maxw); }
      .bio-photo-wrapper {
        position: relative; flex-shrink: 0;
        /* fluid: scales with viewport; min for small laptops, max for ultrawide so it doesn't dominate */
        width: clamp(380px, 46vw, 1000px);
        overflow: hidden;
        border-radius: 10px;
      }
      .about-photo { position: relative; z-index: 1; width: 100%; height: auto; object-fit: unset; object-position: center; border-radius: 0; display: block; transform: none; transition: transform 0.5s; }
      .bio-photo-block { display: flex; flex-direction: column; align-items: flex-start; width: clamp(380px, 46vw, 1000px); }
      .bio-photo-caption { display: inline-flex; align-items: center; gap: 6px; font-family: var(--serif-body); font-style: normal; font-size: var(--text-base); font-weight: 400; line-height: var(--leading-body); letter-spacing: 0; color: var(--text); margin-top: 8px; }
      .bio-pin { font-size: 1.1em; line-height: 1; }
      .about-highlight { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; text-decoration-color: var(--accent); }
      .about-highlight:hover { color: var(--accent); text-decoration-color: var(--accent); }

      /* ── GALLERY ── */
      #gallery .section-tag { font-family: var(--serif); justify-content: center; text-align: center; font-size: var(--heading-section); font-weight: 400; letter-spacing: 0; color: var(--text); }
      #gallery .section-tag.reveal { opacity: 1; transform: none; }
      #gallery .section-tag .slide-from-left { display: inline-block; will-change: transform; }
      .gallery-marquee { display: flex; flex-direction: column; gap: clamp(12px, 1.5vw, 20px); width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
      .gallery-row { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; -ms-overflow-style: none; }
      .gallery-row::-webkit-scrollbar { display: none; }
      .gallery-track { display: flex; align-items: center; gap: clamp(12px, 1.5vw, 20px); width: max-content; }
      .gallery-track.scroll-left  { animation: gallery-scroll-left 90s linear infinite; }
      .gallery-track.scroll-right { animation: gallery-scroll-right 90s linear infinite; }
      .gallery-row:hover .gallery-track { animation-play-state: paused; }
      .gallery-item { margin: 0; flex-shrink: 0; width: clamp(220px, 24vw, 320px); aspect-ratio: 4/3; background: var(--surface); overflow: hidden; position: relative; }
      .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .gallery-item-label { position: absolute; bottom: 12px; left: 12px; font-family: var(--serif-body); font-style: italic; font-size: clamp(11px, 0.85vw, 13px); letter-spacing: 0; color: #FFFFFF; background: rgba(0,0,0,0.5); padding: 3px 8px; }
      @keyframes gallery-scroll-left  { from { transform: translateX(0); }     to { transform: translateX(-50%); } }
      @keyframes gallery-scroll-right { from { transform: translateX(-50%); }  to { transform: translateX(0); }    }
      @media (prefers-reduced-motion: reduce) { .gallery-track { animation: none; } }


      /* ── FOOTER ── */
      footer { max-width: none; margin: 0; padding: var(--space-4) clamp(20px, 5vw, 64px); display: flex; justify-content: flex-start; align-items: flex-start; border-top: 1px solid var(--border); }
      .footer-credit { font-family: var(--serif-body); font-style: italic; font-size: clamp(13px, 1vw, 16px); letter-spacing: 0; color: var(--muted); line-height: 1.8; max-width: 800px; }
      .footer-highlight { color: var(--text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--border); }
      .footer-highlight:hover { color: var(--accent); text-decoration-color: var(--accent); }
      a.footer-highlight:hover { color: var(--text); }

      /* ── ANIMATIONS ── */
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
      .reveal.visible { opacity: 1; transform: none; }

      /* ── RESPONSIVE: SMALL LAPTOPS / TABLETS ── */
      @media (max-width: 900px) {
        /* Hero stacks vertically; padding pulled in so nothing hugs the edge */
        #about {
          flex-direction: column;
          align-items: stretch;
          gap: clamp(20px, 4vw, 32px);
          padding-left: clamp(20px, 5vw, 48px);
          padding-right: clamp(20px, 5vw, 48px);
          padding-top: clamp(32px, 6vw, 56px);
          padding-bottom: clamp(32px, 6vw, 56px);
          min-height: auto;
          max-width: 100%;
        }
        /* Trim nav side padding and let the long name+tagline wrap */
        nav { padding: clamp(12px, 2.4vw, 20px) clamp(20px, 4vw, 40px); flex-wrap: wrap; row-gap: 12px; }
        .nav-logo-name { font-size: clamp(22px, 4vw, 32px); white-space: normal; line-height: 1.2; }

        .about-text-body { width: 100%; max-width: 100%; margin: 0; }
        .bio-stack { width: 100%; align-items: flex-start; margin: 0; }
        .bio-photo-block { width: 100%; align-items: flex-start; }
        .bio-photo-wrapper { width: 100%; aspect-ratio: auto; }
        .about-text-body::before, .about-text-body::after { display: none; }
      }

      /* ── RESPONSIVE: PHONES (iPhone-friendly) ── */
      @media (max-width: 600px) {
        #about {
          padding: clamp(28px, 6vw, 44px) clamp(16px, 4.5vw, 24px) clamp(40px, 8vw, 64px);
          gap: clamp(20px, 5vw, 28px);
        }
        /* Nav stacks: name+tagline on top, then icons */
        nav {
          flex-direction: column;
          align-items: flex-start;
          gap: 14px;
          padding: 16px clamp(16px, 4.5vw, 24px);
        }
        .nav-logo { width: 100%; gap: 4px; }
        .nav-logo-name { font-size: clamp(20px, 5.5vw, 26px); white-space: normal; line-height: 1.2; }
        .nav-logo-tagline { display: block; font-size: 0.72em; margin-top: 2px; white-space: normal; }
        .nav-logo-thai-row { flex-wrap: wrap; gap: 8px; }
        .nav-logo-thai, .nav-logo-phonetic { font-size: clamp(14px, 4.2vw, 18px); }
        .nav-icons { width: 100%; justify-content: flex-start; flex-wrap: wrap; gap: 14px 18px; }
        .nav-icon svg { width: 22px; height: 22px; }
        .nav-icon--with-text span { font-size: 14px; }

        /* Body text: keep readable but don't break the viewport */
        .about-text-body { width: 100%; max-width: 100%; }
        .about-body { font-size: 16px; line-height: 1.65; }
        .bio-photo-caption { font-size: 16px; }
        .about-name { font-size: clamp(26px, 7vw, 36px); }
        .bio-photo-wrapper { width: 100%; max-width: 100%; }
        .bio-photo-block { width: 100%; }

        .pronunciation-btn svg { width: 20px; height: 20px; }

        /* Footer: tighter side padding so the credit line breathes */
        footer { padding: clamp(20px, 5vw, 32px) clamp(16px, 4.5vw, 24px); }
        .footer-credit { font-size: 13px; line-height: 1.6; }
      }

      /* ── RESPONSIVE: VERY SMALL PHONES (iPhone SE) ── */
      @media (max-width: 400px) {
        .nav-logo-name { font-size: clamp(18px, 5.8vw, 22px); }
        .nav-logo-tagline { font-size: 0.7em; }
        .about-name { font-size: 22px; }
        .about-body { font-size: 15px; }
        .bio-photo-caption { font-size: 15px; }
      }
    </style>

    <script>
      // ── PRONUNCIATION BUTTON ─────────────────────────────────
      const pronunciationBtn = document.getElementById('pronunciation-btn');
      const thaiAudio = document.getElementById('thai-name-audio');
      if (pronunciationBtn && thaiAudio) {
        pronunciationBtn.addEventListener('click', () => {
          thaiAudio.currentTime = 0;
          thaiAudio.play().catch(() => { /* file may not be present yet */ });
        });
      }

      // ── GALLERY TAG: one-time rise-up on enter ───
      const riseObserver = new IntersectionObserver(entries => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            target.classList.add('risen');
            riseObserver.unobserve(target);
          }
        });
      }, { threshold: 0.2 });
      document.querySelectorAll('.gallery-tag').forEach(el => riseObserver.observe(el));

// ── SCROLL REVEAL ─────────────────────────────────────────
      const revealObserver = new IntersectionObserver(entries => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            target.classList.add('visible');
            revealObserver.unobserve(target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>

  </body> 
</html>
