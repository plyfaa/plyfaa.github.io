---
import '../styles/global.css';
---

<!-- Developed by Plyfaa Suwanamalik-Murphy. Last modified: 03/5/2026 -->

<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Plyfaa Suwanamalik-Murphy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@200;300;400;500;600;700&display=swap" rel="stylesheet"/>
  </head>

  <body>

    <!-- CUSTOM CURSOR: dot + lagging ring -->
    <div class="cursor" id="cursor"></div>
    <div class="cursor-ring" id="cursor-ring"></div>

    <!-- NAV: Fixed top bar, background present on scroll -->
    <nav id="nav">
      <a href="#about" class="nav-logo">Plyfaa Suwanamalik-Murphy</a>
      <ul class="nav-links">
        <li><a href="#research">Research</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <!-- ABOUT: Bio + photo -->
    <section id="about">
      <div class="about-text reveal">
        <img src="/smithsonian.jpg" alt="Plyfaa Suwanamalik-Murphy" class="about-photo"/>
        <p class="about-body">
          I'm fascinated by the eyes and what they reveal about our perception.
        </p>
        <p class="about-body">
          I'm an incoming PhD student in
          <a href="https://bradylab.ucsd.edu" class="about-highlight" target="_blank">Dr. Timothy Brady's Visual and Memory Lab</a> at
          <a href="https://ucsd.edu" class="about-highlight" target="_blank">UC San Diego</a>. Currently, I'm a Research Fellow at the
          <a href="https://www.nih.gov" class="about-highlight" target="_blank">National Institutes of Health</a> in
          <a href="https://fim.nimh.nih.gov/" class="about-highlight" target="_blank">Dr. Peter Bandettini's lab</a>, where I'm investigating how we can control
          pupil size in real time to improve our perception. Previously, I built
          decoding pipelines for BCIs as a
          <a href="https://www.simonsfoundation.org" class="about-highlight" target="_blank">Simons Foundation Fellow</a> under
          <a href="https://neuroprosthetics.science/" class="about-highlight" target="_blank">Dr. Sergey Stavisky</a>, and investigated visual perception at the
          <a href="https://www.psy.ox.ac.uk/" class="about-highlight" target="_blank">University of Oxford</a> advised by
          <a href="https://www.psy.ox.ac.uk/people/hannah-smithson" class="about-highlight" target="_blank">Dr. Hannah Smithson</a>.
        </p>
        <p class="about-body">
          I completed my Bachelor's in Cognitive Science from
          <a href="https://ucdavis.edu" class="about-highlight" target="_blank">UC Davis</a> in 2 years. And spent most of that time learning as much as I could about eye-tracking,
          EEG, and visual cognition, finding my way into as many research <a href="/cv.pdf" class="about-highlight" target="_blank">research opportunities</a> as I could.
        </p>
      </div>
      <svg class="about-curve" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M 0 0 Q 500 130 1000 0" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      </svg>
    </section>

    <!-- RESEARCH: Numbered list of projects -->
    <section id="research">
      <p class="section-tag reveal">Research</p>
      <div class="research-list">
        <div class="research-item reveal" data-project="semantic-congruency" role="button" tabindex="0">
          <div>
            <p class="research-meta">NSF GRFP Research Proposal · 2025 - present</p>
            <h3 class="research-title">Neural and Behavioral Dynamics of Semantic Congruency in Visual Search</h3>
            <p class="research-desc">Visual search is an everyday activity where humans effectively integrate multiple sources of information to find relevant objects. Recent evidence demonstrates that semantic congruency, how well an object fits within its scene context, drives overt visual attention. Read more about my proposal here!</p>
          </div>
          <div class="project-badges">
            <span class="project-view">View Project</span>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY: Grid of six photos -->
    <section id="gallery">
      <p class="section-tag reveal">Gallery</p>
      <div class="gallery-grid reveal">
        <div class="gallery-item">
          <img src="/smithsonian.jpg" alt="NIMH Oral Presentation"/>
          <span class="gallery-item-label">NIMH/NIH Selected Lightning Talk Speaker</span>
        </div>
        <div class="gallery-item">
          <img src="/art.jpg" alt="Art and Science"/>
          <span class="gallery-item-label">3rd Place Art Winner! "Waves of Consciousness"</span>
        </div>
        <div class="gallery-item">
          <img src="/poster.jpg" alt="ASSC Presentation"/>
          <span class="gallery-item-label">Oral presentation at NIMH/NIH</span>
        </div>
        <div class="gallery-item">
          <img src="/assc.jpg" alt="Oxford"/>
          <span class="gallery-item-label">Oral Presentation in Crete, Greece</span>
        </div>
        <div class="gallery-item">
          <img src="/talk.jpg" alt="Poster Presentation"/>
          <span class="gallery-item-label">Advocating for environmentally friendly infrastructure</span>
        </div>
        <div class="gallery-item">
          <img src="/oxford.jpg" alt="Poster Presentation"/>
          <span class="gallery-item-label">Perception of iridescence at the University of Oxford</span>
        </div>
      </div>
    </section>

    <!-- PROJECTS: Current side projects -->
    <section id="projects">
      <p class="section-tag reveal">Side Projects</p>
      <a href="https://try-nudge.com/" target="_blank" rel="noopener" class="project-card reveal">
        <img src="/nudge.png" alt="Nudge — focus tracking web app" class="project-preview" />
        <div class="project-card-body">
          <p class="research-meta">Web App · In Development · 2026</p>
          <h3 class="research-title">Focus tracking, study tools, and smarter breaks</h3>
          <p class="research-desc">A web app designed to help you stay focused, study more effectively, and take smarter breaks.</p>
          <span class="project-view">View Project</span>
        </div>
      </a>
    </section>

    <!-- CONTACT: Email + external links -->
    <section id="contact">
      <div class="reveal">
        <p class="section-tag">Contact</p>
        <p class="contact-body">Reach out to talk about vision and perception, collaborations, or just to schedule a coffee chat.</p>
        <a href="mailto:plysuwana@gmail.com" class="contact-email">plysuwana@gmail.com</a>
      </div>
      <div class="contact-links reveal">
        <a href="https://www.linkedin.com/in/plyfaa-murphy/" class="contact-link" target="_blank">
          <span>LinkedIn</span><span class="contact-link-arrow">→</span>
        </a>
        <a href="https://github.com/plyfaa" class="contact-link" target="_blank">
          <span>GitHub</span><span class="contact-link-arrow">→</span>
        </a>
        <a href="https://scholar.google.com/citations?user=TCRiqYcAAAAJ&hl=en" class="contact-link" target="_blank">
          <span>Google Scholar</span><span class="contact-link-arrow">→</span>
        </a>
        <a href="/cv.pdf" class="contact-link">
          <span>Curriculum Vitae</span><span class="contact-link-arrow">→</span>
        </a>
      </div>
    </section>

    <footer>
      <p class="footer-credit">
        Loosely designed in <a href="https://figma.com" class="footer-highlight" target="_blank">Figma</a> and coded in
        <a href="https://code.visualstudio.com" class="footer-highlight" target="_blank">Visual Studio Code</a> by yours truly. Built with
        <a href="https://astro.build" class="footer-highlight" target="_blank">Astro</a> and CSS,
        deployed with <a href="https://pages.github.com" class="footer-highlight" target="_blank">GitHub Pages</a>. All text is set in the
        <a href="https://www.figma.com/fonts/inter/" class="footer-highlight" target="_blank">Inter</a>,
        <a href="https://www.figma.com/fonts/playfair-display/" class="footer-highlight" target="_blank">Playfair Display</a>, and
        <a href="https://www.figma.com/fonts/dm-mono/" class="footer-highlight" target="_blank">DM Mono</a> typefaces.
      </p>
    </footer>

    <!-- RESEARCH DETAIL: Opens as full-page overlay -->
    <div class="research-modal-overlay" id="research-modal">
      <div class="research-modal">
        <button class="modal-close" id="modal-close" aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <div class="modal-content" id="modal-content">
          <!-- Dynamically populated by JS -->
        </div>
      </div>
    </div>

    <style is:global>
      /* ── DESIGN TOKENS ("this is my color") ── */
      :root {
        --bg:       #D4C2B4;
        --surface:  #E0E6EE;
        --border:   rgba(255,255,255,0.5);
        --blue:     #FFFFFF;
        --blue-dim: rgba(255,255,255,0.5);
        --text:     #000000;
        --mono:     'Roboto Slab', serif;
        --serif:    'Roboto Slab', serif;
        --sans:     'Roboto Slab', serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--sans); background: var(--bg); color: var(--text); overflow-x: hidden; cursor: none; }

      /* ── CURSOR ── */
      .cursor, .cursor-ring { position: fixed; border-radius: 50%; pointer-events: none; transform: translate(-50%, -50%); }
      .cursor { width: 8px; height: 8px; background: var(--blue); z-index: 9999; transition: width 0.2s, height 0.2s, opacity 0.2s; }
      .cursor-ring { display: none; }

      /* ── NAV ── */
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        display: flex; justify-content: space-between; align-items: center;
        padding: 28px clamp(20px, 5vw, 64px); border-bottom: 1px solid var(--text);
        transition: background 0.3s;
      }
      nav.scrolled { background: rgba(212,194,180,0.85); backdrop-filter: blur(12px); }
      .nav-logo { font-family: var(--sans); font-size: clamp(11px, 1.1vw, 16px); color: var(--text); text-decoration: none; white-space: nowrap; }
      .nav-links { display: flex; gap: clamp(12px, 2.4vw, 32px); list-style: none; }
      .nav-links a { font-family: var(--sans); font-size: clamp(8px, 0.85vw, 12px); letter-spacing: 1.5px; text-transform: uppercase; color: var(--blue); text-decoration: none; transition: color 0.2s; white-space: nowrap; }
      .nav-links a:hover { color: var(--text); }

      /* ── SECTION BASE ── */
      section { padding: clamp(48px, 7vw, 90px) clamp(20px, 5vw, 64px); border-bottom: 1px solid var(--border); }
      .section-tag { font-family: var(--mono); font-size: clamp(11px, 1.1vw, 15px); letter-spacing: 4px; text-transform: uppercase; color: var(--blue); margin-bottom: clamp(24px, 3.5vw, 48px); display: flex; align-items: center; gap: 16px; }
      /* removed the decorative blue line next to section headers */
      .section-tag::after { display: none; }

      /* ── ABOUT ── */
      #about { padding-top: clamp(120px, 14vw, 180px); border-bottom: none; }
      #research, #gallery { border-bottom: none; }
      .about-curve { display: block; width: 100vw; height: clamp(60px, 8vw, 110px); margin: clamp(60px, 8vw, 120px) calc(50% - 50vw) 0; }
      .about-text { max-width: 1100px; margin: 0 auto; display: flow-root; }
      .about-name { font-family: var(--serif); font-size: clamp(24px, 3vw, 40px); line-height: 1.3; color: var(--text); margin-bottom: 32px; }
      .about-name em { font-style: italic; color: var(--blue); }
      .about-body { font-size: clamp(13px, 1.2vw, 16px); font-weight: 200; color: rgba(0,0,0,0.75); line-height: 1.8; margin-bottom: 24px; }
      .about-photo { float: left; width: clamp(180px, 28vw, 320px); aspect-ratio: 3/5; object-fit: cover; object-position: top; border-radius: 50%; border: 1px solid var(--border); margin: 6px clamp(28px, 4vw, 56px) 16px 0; shape-outside: ellipse(50% 50%); shape-margin: 12px; filter: grayscale(20%) brightness(0.65); transition: filter 0.5s; }
      .about-photo:hover { filter: none; }
      .about-photo-label { font-family: var(--mono); font-size: clamp(8px, 0.8vw, 10px); letter-spacing: 2px; text-transform: uppercase; color: rgba(0,0,0,0.6); text-align: right; margin-top: 10px; }
      .about-highlight { color: var(--blue); text-decoration: none; transition: color 0.2s; }
      .about-highlight:hover { color: var(--text); }

      /* ── RESEARCH ── */
      .research-list { display: flex; flex-direction: column; }
      .research-item {
        display: grid; grid-template-columns: 1fr auto; gap: clamp(16px, 3vw, 40px); align-items: start;
        padding: clamp(24px, 3vw, 40px) 0; border-bottom: 1px solid var(--border);
        transition: background 0.2s, padding-left 0.3s; cursor: none; position: relative;
      }
      .research-item:first-child { border-top: 1px solid var(--border); }
      .research-item:hover { background: rgba(255,255,255,0.08); padding-left: 5px; }
      .research-num { font-family: var(--mono); font-size: clamp(11px, 1vw, 14px); letter-spacing: 2px; color: var(--blue); padding-top: 4px; }
      .research-title { font-family: var(--serif); font-size: clamp(16px, 1.7vw, 22px); color: var(--text); margin-bottom: 10px; line-height: 1.3; }
      .research-meta { font-family: var(--mono); font-size: clamp(10px, 1.1vw, 15px); letter-spacing: 2px; text-transform: uppercase; color: var(--blue-dim); margin-bottom: 14px; }
      .research-desc { font-size: clamp(13px, 1.1vw, 15px); font-weight: 300; color: rgba(0,0,0,0.75); line-height: 1.8; max-width: 560px; }
      .research-badge { font-family: var(--mono); font-size: clamp(9px, 0.9vw, 12px); letter-spacing: 2px; text-transform: uppercase; border: 3px solid var(--border); color: var(--blue); padding: 6px 12px; border-radius: 2px; white-space: nowrap; }

      /* ── PROJECTS ── */
      .project-card {
        display: block; text-decoration: none; color: inherit; border-radius: 4px;
        overflow: hidden; transition: transform 0.3s; cursor: none;
        max-width: 480px;
      }
      .project-card:hover { transform: translateY(-4px); }
      .project-preview { width: 100%; display: block; }
      .project-card-body { padding: clamp(20px, 3vw, 40px); }
      .project-card-body .research-meta { margin-bottom: 14px; }
      .project-card-body .research-title { margin-bottom: 10px; }
      .project-card-body .research-desc { margin-bottom: 20px; }
      .project-view { display: inline-block; font-family: var(--mono); font-size: clamp(9px, 0.9vw, 12px); letter-spacing: 2px; text-transform: uppercase; border: 3px solid var(--blue); color: var(--blue); padding: 6px 12px; border-radius: 2px; white-space: nowrap; transition: background 0.2s, color 0.2s; }
      .project-card:hover .project-view, .research-item:hover .project-view { background: var(--blue); color: var(--text); }

      /* ── GALLERY ── */
      .gallery-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: clamp(140px, 20vw, 280px) clamp(140px, 20vw, 280px); gap: 2px; }
      .gallery-item { background: var(--surface); border: 1px solid var(--border); overflow: hidden; position: relative; cursor: none; }
      .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
      .gallery-item:hover img { transform: scale(1.015); }
      .gallery-item-label { position: absolute; bottom: 16px; left: 16px; font-family: var(--mono); font-size: clamp(7px, 0.8vw, 10px); letter-spacing: 2px; text-transform: uppercase; color: rgba(0,0,0,0.75); background: rgba(8,12,20,0.7); padding: 4px 10px; border-radius: 2px; }

      /* ── CONTACT ── */
      #contact { min-height: auto; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
      .contact-heading { font-family: var(--serif); font-size: clamp(28px, 3.8vw, 50px); line-height: 1.0; color: var(--text); margin-bottom: 32px; }
      .contact-heading em { font-style: italic; color: var(--blue); }
      .contact-body { font-size: clamp(13px, 1.2vw, 16px); font-weight: 300; color: rgba(0,0,0,0.75); line-height: 1.8; margin-bottom: 40px; max-width: 360px; }
      .contact-email { font-family: var(--serif); font-size: clamp(14px, 1.5vw, 20px); color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 8px; display: inline-block; transition: border-color 0.2s, color 0.2s; }
      .contact-email:hover { border-color: var(--blue); color: var(--blue); }
      .contact-links { display: flex; flex-direction: column; padding-top: clamp(32px, 6vw, 80px); }
      .contact-link { display: flex; justify-content: space-between; align-items: center; padding: clamp(12px, 1.5vw, 20px) 0; border-bottom: 1px solid var(--border); text-decoration: none; color: rgba(0,0,0,0.75); font-family: var(--mono); font-size: clamp(10px, 0.9vw, 12px); letter-spacing: 2px; text-transform: uppercase; transition: color 0.2s; }
      .contact-link:hover { color: var(--blue); }
      .contact-link-arrow { font-size: clamp(20px, 2.2vw, 30px); opacity: 0; transition: opacity 0.2s, transform 0.2s; }
      .contact-link:hover .contact-link-arrow { opacity: 1; transform: translateX(4px); }

      /* ── FOOTER ── */
      footer { padding: clamp(24px, 3.5vw, 48px) clamp(20px, 5vw, 64px); display: flex; justify-content: space-between; align-items: start; border-top: 1px solid var(--border); }
      .footer-credit { font-size: clamp(11px, 1vw, 14px); letter-spacing: 0.5px; color: rgba(0,0,0,0.75); line-height: 1.8; max-width: 800px; }
      .footer-highlight { color: #FFFFFF; }
      a.footer-highlight { text-decoration: none; }
      a.footer-highlight:hover { color: var(--text); }

      /* ── RESEARCH MODAL ── */
      .research-modal-overlay {
        position: fixed; inset: 0; z-index: 200;
        background: rgba(212, 194, 180, 0.0); backdrop-filter: blur(0px);
        pointer-events: none; opacity: 0; overflow-y: auto;
        transition: background 0.4s ease, backdrop-filter 0.4s ease, opacity 0.4s ease;
      }
      .research-modal-overlay.open {
        opacity: 1; pointer-events: all;
        background: rgba(212, 194, 180, 0.92); backdrop-filter: blur(20px);
      }
      .research-modal {
        max-width: 860px; margin: 0 auto; padding: clamp(60px, 8vw, 100px) clamp(20px, 5vw, 64px) clamp(40px, 6vw, 80px);
        transform: translateY(40px); opacity: 0;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
      }
      .research-modal-overlay.open .research-modal { transform: translateY(0); opacity: 1; }
      .modal-close {
        position: fixed; top: 32px; right: 40px;
        background: none; border: none; color: var(--text);
        width: 48px; height: 48px;
        display: flex; align-items: center; justify-content: center;
        cursor: none; transition: color 0.2s; z-index: 201;
      }
      .modal-close:hover { color: var(--blue); }
      .modal-content .modal-tag { font-family: var(--mono); font-size: clamp(10px, 1vw, 14px); letter-spacing: 4px; text-transform: uppercase; color: var(--blue); display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
      /* hide line adjacent to modal tag */
      .modal-content .modal-tag::after { display: none; }
      .modal-content .modal-heading { font-family: var(--serif); font-size: clamp(22px, 2.7vw, 35px); color: var(--text); line-height: 1.15; margin-bottom: 16px; }
      .modal-content .modal-section-label { font-family: var(--mono); font-size: clamp(10px, 1vw, 14px); letter-spacing: 3px; text-transform: uppercase; color: var(--blue); margin-bottom: 16px; margin-top: 56px; }
      .modal-content .modal-body { font-size: clamp(13px, 1.1vw, 15px); font-weight: 300; color: rgba(0,0,0,0.75); line-height: 1.9; margin-bottom: 16px; max-width: 680px; }
      .modal-content .modal-image-grid img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border: 1px solid var(--border); border-radius: 2px; display: block; filter: grayscale(15%) brightness(0.9); transition: filter 0.4s; }
      .modal-body-grid { display: grid; grid-template-columns: 1fr 160px; gap: clamp(24px, 3.5vw, 48px); margin-top: 32px; }
      .modal-body-main { min-width: 0; }
      .modal-sidebar { border-left: 1px solid var(--border); padding-left: 24px; }
      .modal-sidebar-item { margin-bottom: 20px; }
      .modal-sidebar-label { display: block; font-family: var(--mono); font-size: clamp(10px, 1vw, 14px); letter-spacing: 2px; text-transform: uppercase; color: var(--blue-dim); margin-bottom: 4px; }
      .modal-sidebar-value { display: block; font-family: var(--mono); font-size: clamp(10px, 0.95vw, 13px); color: rgba(0,0,0,0.75); font-weight: 300; }
      .modal-file-list { display: flex; flex-direction: column; }
      .modal-file-item { display: flex; align-items: center; gap: 10px; padding: 14px 0; text-decoration: none; cursor: none; transition: background 0.2s; }
      .modal-file-icon { font-size: 30px; }
      .modal-file-name { font-family: var(--mono); font-size: clamp(11px, 1vw, 14px); letter-spacing: 1px; color: rgba(0,0,0,0.75); flex: 1; }
      .modal-file-open { font-family: var(--mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--blue); opacity: 0; transition: opacity 0.2s; }
      .modal-file-item:hover .modal-file-open { opacity: 1; }
      .modal-file-item:hover .modal-file-name { color: var(--text); }
      body.modal-open { overflow: hidden; }

      /* ── ANIMATIONS ── */
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
      .reveal.visible { opacity: 1; transform: none; }

      /* ── RESPONSIVE: SMALL LAPTOPS / TABLETS ── */
      @media (max-width: 900px) {

        .modal-body-grid { grid-template-columns: 1fr; }
        .modal-sidebar { border-left: none; padding-left: 0; border-top: 1px solid var(--border); padding-top: 24px; display: flex; flex-wrap: wrap; gap: 16px 32px; }
      }

      /* ── RESPONSIVE: PHONES ── */
      @media (max-width: 600px) {
        /* Disable custom cursor on touch devices */
        body { cursor: auto; }
        .cursor, .cursor-ring { display: none; }
        .research-item, .gallery-item, .modal-close, .contact-link { cursor: auto; }

        /* Photo above text on phones — no float wrap */
        .about-photo { float: none; shape-outside: none; width: 60%; margin: 0 auto 24px; display: block; }

        #contact { grid-template-columns: 1fr; }
        .contact-links { padding-top: 0; }

        /* Gallery: 2 columns on phone */
        .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(3, clamp(120px, 30vw, 200px)); }

        /* Research items: stack on mobile */
        .research-item { grid-template-columns: 1fr; }
        .research-num { display: none; }
        .project-badges { align-items: flex-start; }

        /* Modal sidebar stacks */
        .modal-body-grid { grid-template-columns: 1fr; }
        .modal-sidebar { border-left: none; padding-left: 0; border-top: 1px solid var(--border); padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px 24px; }

        /* Nav: shrink gap and logo size to prevent overlap */
        .nav-logo { font-size: 12px; }
        /* Nav: right-align wrapped links */
        .nav-links { gap: 8px 16px; flex-wrap: wrap; justify-content: flex-end; }
        .nav-links a { font-size: 10px; letter-spacing: 1px; }
      }

      /* ── RESPONSIVE: VERY SMALL PHONES ── */
      @media (max-width: 400px) {
        .nav-links { flex-wrap: wrap; gap: 8px 12px; justify-content: flex-end; }
        .gallery-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
      }
    </style>

    <script>
      // ── CUSTOM CURSOR ────────────────────────────────────────
      const cursorDot = document.getElementById('cursor');
      const cursorRing = document.getElementById('cursor-ring');
      let mouseX = 0, mouseY = 0, ringX = 0, ringY = 0;

      document.addEventListener('mousemove', e => {
        mouseX = e.clientX; mouseY = e.clientY;
        cursorDot.style.left = mouseX + 'px';
        cursorDot.style.top  = mouseY + 'px';
      });

      (function animateRing() {
        ringX += (mouseX - ringX) * 0.25;
        ringY += (mouseY - ringY) * 0.25;
        cursorRing.style.left = ringX + 'px';
        cursorRing.style.top  = ringY + 'px';
        requestAnimationFrame(animateRing);
      })();

      document.querySelectorAll('a, button, .gallery-item, .research-item, .modal-close').forEach(el => {
        el.addEventListener('mouseenter', () => {
          cursorDot.style.width = cursorDot.style.height = '20px';
          cursorDot.style.opacity = '0.5';
          cursorRing.style.width = cursorRing.style.height = '50px';
        });
        el.addEventListener('mouseleave', () => {
          cursorDot.style.width = cursorDot.style.height = '8px';
          cursorDot.style.opacity = '1';
          cursorRing.style.width = cursorRing.style.height = '32px';
        });
      });

      // ── NAV ──────────────────────────────────────────────────
      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));

      // ── SCROLL REVEAL ─────────────────────────────────────────
      const revealObserver = new IntersectionObserver(entries => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            target.classList.add('visible');
            revealObserver.unobserve(target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      // ── RESEARCH DETAIL MODAL (JS) ─────────────────────────────────
      const projectData = {
        'semantic-congruency': {
          tag: '',
          title: 'Semantic Congruency Effects on Visual Attention',
          sidebar: {},
          overview: `Visual search is an everyday activity where humans effectively integrate
          multiple sources of information to find relevant objects. Recent evidence
          shows that semantic congruency, how well an object fits within its scene
          context, drives overt attention. When viewing a scene, we rapidly extract its
          gist, which activates schemas encoding expectations about which objects are
          likely to appear. While much has been revealed about recognition of
          individual objects in isolation, the neural mechanisms underlying attention to
          congruent versus incongruent objects within naturalistic scenes remain poorly
          understood.`,
          methods: `Aim 1 develops an open-source dataset of ~450 scenes with systematically 
          graded congruency levels (low, medium, high). Aim 2 uses eye-tracking and EEG to 
          adjudicate between the facilitation and interference models explaining semantic 
          congruency effects on visual attention.`,
          files: [
            { name: 'NSF GRFP Research Proposal', path: 'https://drive.google.com/file/d/1wOT4NLdTZXYkIw26foogs5lxleW_BVvL/view?usp=sharing', type: 'pdf' },
          ],
        },
      };

      const modal = document.getElementById('research-modal');
      const modalContent = document.getElementById('modal-content');
      const modalClose = document.getElementById('modal-close');

      function openProject(projectId) {
        const data = projectData[projectId];
        if (!data) return;

        const s = data.sidebar;
        const sidebarItems = [
          { label: 'Institution', value: s.institution },
          { label: 'Advisor', value: s.advisor },
          { label: 'Duration', value: s.duration },
          { label: 'Funding', value: s.funding },
          { label: 'Funder', value: s.funder },
        ];

        const sidebarHTML = sidebarItems.filter(item => item.value).map(item => `
          <div class="modal-sidebar-item">
            <span class="modal-sidebar-label">${item.label}</span>
            <span class="modal-sidebar-value">${item.value}</span>
          </div>
        `).join('');

        const files = data.files?.filter(f => f.path) || [];
        const filesHTML = files.length > 0 ? `
          <p class="modal-section-label">Documents</p>
          <div class="modal-file-list">
            ${files.map(f => `
              <a href="${f.path}" target="_blank" class="modal-file-item">
                <span class="modal-file-icon">${f.type === 'pdf' ? '📄' : '🖼'}</span>
                <span class="modal-file-name">${f.name}</span>
                <span class="modal-file-open">Open →</span>
              </a>
            `).join('')}
          </div>
        ` : '';

        modalContent.innerHTML = `
          ${data.tag ? `<p class="modal-tag">${data.tag}</p>` : ''}
          <h2 class="modal-heading">${data.title}</h2>
          <div class="modal-body-grid">
            <div class="modal-body-main">
              <p class="modal-section-label">Overview</p>
              <p class="modal-body">${data.overview}</p>
              <p class="modal-section-label">Methods</p>
              <p class="modal-body">${data.methods}</p>
              ${filesHTML}
            </div>
            ${sidebarHTML ? `<div class="modal-sidebar">${sidebarHTML}</div>` : ''}
          </div>
        `;

        document.body.classList.add('modal-open');
        modal.classList.add('open');
      }

      function closeProject() {
        modal.classList.remove('open');
        document.body.classList.remove('modal-open');
      }

      document.querySelectorAll('.research-item[data-project]').forEach(item => {
        item.addEventListener('click', () => openProject(item.dataset.project));
        item.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openProject(item.dataset.project); }
        });
      });

      modalClose.addEventListener('click', closeProject);
      modal.addEventListener('click', e => { if (e.target === modal) closeProject(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeProject(); });
    </script>

  </body> 
</html>
