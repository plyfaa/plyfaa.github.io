      }
      .about-photo { position: relative; z-index: 1; width: 100%; height: auto; object-fit: unset; object-position: center; border-radius: 0; display: block; transform: none; transition: transform 0.5s; }
      .bio-photo-block { display: flex; flex-direction: column; align-items: flex-start; width: clamp(260px, 31vw, 460px); }
      /* nudge to discover the hover egg; sits above the photo and retires once you've found it */
      .bio-photo-hint {
        /* full-width banner matching the photo, not a left-hugging shrink-wrapped label */
        display: block; width: 100%; text-align: center;
        padding: 9px 14px; margin-bottom: 12px;
        background: rgba(214, 130, 110, 0.15); border-radius: 8px;
        font-family: var(--serif-body); font-style: italic; font-size: clamp(17px, 1.7vw, 23px);
        line-height: 1.4; color: var(--accent); letter-spacing: 0;
        opacity: 1; transition: opacity 0.35s ease;
