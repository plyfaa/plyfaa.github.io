---
import '../styles/global.css';
import ScrollingCode from '../components/ScrollingCode.astro';

const row1 = [
  { src: '/smithsonian.jpg', alt: 'NIMH Oral Presentation', label: 'NIMH/NIH Selected Lightning Talk Speaker' },
  { src: '/art.jpg', alt: 'Art and Science', label: '3rd Place Art Winner! "Waves of Consciousness"' },
  { src: '/poster.jpg', alt: 'ASSC Presentation', label: 'Oral presentation at NIMH/NIH' },
  { src: '/assc.jpg', alt: 'Crete', label: 'Oral Presentation in Crete, Greece' },
  { src: '/talk.jpg', alt: 'Poster Presentation', label: 'Advocating for environmentally friendly infrastructure' },
  { src: '/oxford.jpg', alt: 'Oxford', label: 'Perception of iridescence at the University of Oxford' },
  { src: '/narcan.jpg', alt: 'Narcan', label: '' },
];

const row2 = [
  { src: '/Hawaii Pacific Neuroscience summer cohort.jpg', alt: 'Hawaii Pacific Neuroscience summer cohort', label: 'Hawaii Pacific Neuroscience summer cohort' },
  { src: '/SFIM lab dinner.jpeg', alt: 'SFIM lab dinner', label: 'SFIM lab dinner' },
  { src: '/Summer internship social in Oahu.jpg', alt: 'Summer internship social in Oahu', label: 'Summer internship social in Oahu' },
  { src: '/Summer_internship_in_Oahu.jpg', alt: 'Summer internship in Oahu', label: 'Summer internship in Oahu' },
  { src: '/graduation.jpeg', alt: 'Graduation', label: 'Graduation' },
];
---

<!-- Developed by Plyfaa Suwanamalik-Murphy. Last modified: 03/5/2026 -->

<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Plyfaa Suwanamalik-Murphy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  </head>

  <body>

    <!-- NAV: Fixed top bar, background present on scroll -->
    <nav id="nav">
      <a href="#about" class="nav-logo">Plyfaa Suwanamalik-Murphy</a>
      <span class="nav-status"><em>website build in progress!</em></span>
      <ul class="nav-links">
        <li><a href="#gallery">From the Lab</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <!-- ABOUT: Bio + photo -->
    <section id="about">
      <ScrollingCode variant="backdrop" side="right" />
      <div class="hero-design-bg" aria-hidden="true"></div>
<div class="about-text-body">
          <p class="about-body">
            I'm fascinated by the eyes and what they reveal about our perception.
          </p>
          <p class="about-body">
            I'm an incoming PhD student in
            <a href="https://bradylab.ucsd.edu" class="about-highlight" target="_blank">Dr. Timothy Brady's Visual and Memory Lab</a> at
            <a href="https://ucsd.edu" class="about-highlight" target="_blank">UC San Diego</a>. Currently, I'm a Research Fellow at the
            <a href="https://www.nih.gov" class="about-highlight" target="_blank">National Institutes of Health</a> in
            <a href="https://fim.nimh.nih.gov/" class="about-highlight" target="_blank">Dr. Peter Bandettini's lab</a>, where I'm investigating how we can control
            pupil size in real time to improve our perception. Previously, I built
            decoding pipelines for BCIs as a
            <a href="https://www.simonsfoundation.org" class="about-highlight" target="_blank">Simons Foundation Fellow</a> under
            <a href="https://neuroprosthetics.science/" class="about-highlight" target="_blank">Dr. Sergey Stavisky</a>, and investigated visual perception at the
            <a href="https://www.psy.ox.ac.uk/" class="about-highlight" target="_blank">University of Oxford</a> advised by
            <a href="https://www.psy.ox.ac.uk/people/hannah-smithson" class="about-highlight" target="_blank">Dr. Hannah Smithson</a>.
          </p>
          <p class="about-body">
            I completed my Bachelor's in Cognitive Science from
            <a href="https://ucdavis.edu" class="about-highlight" target="_blank">UC Davis</a> in 2 years. And spent most of that time learning as much as I could about eye-tracking,
            EEG, and visual cognition, finding my way into as many research <a href="/cv.pdf" class="about-highlight" target="_blank">research opportunities</a> as I could.
          </p>
      </div>
      <div class="bio-stack">
        <div class="bio-photo-block">
          <div class="bio-photo-wrapper">
            <img src="/hero_pic.jpeg" alt="Plyfaa Suwanamalik-Murphy" class="about-photo bio-photo"/>
          </div>
          <span class="bio-photo-caption"><span class="bio-pin">📍</span>Crete, Greece</span>
        </div>
      </div>
    </section>

    {/* EXPERIENCES: Radial orbit — commented out for now
    <section id="experiences">
      <div class="orbit-wrap reveal">
        <div class="orbit" id="orbit">
          <div class="orbit-item" style="--angle: 0deg"></div>
          <div class="orbit-item" style="--angle: 90deg"></div>
          <div class="orbit-item" style="--angle: 180deg"></div>
          <div class="orbit-item" style="--angle: 270deg"></div>
        </div>
        <span class="orbit-center">Projects</span>
        <span class="orbit-note">In progress! (May 2026)</span>
      </div>
    </section>
    */}

    <!-- GALLERY: Grid of six photos -->
    <section id="gallery">
      <p class="section-tag reveal gallery-tag"><span class="slide-from-left">From the Lab</span></p>
      <div class="gallery-marquee reveal">
        <div class="gallery-row">
          <div class="gallery-track gallery-track-left slow">
            {[...row1, ...row1].map((p, i) => (
              <div class={`gallery-item ${(i % row1.length) % 2 === 0 ? 'shift-up' : 'shift-down'}`}>
                <img src={p.src} alt={p.alt} />
                <span class="gallery-item-label">{p.label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="gallery-row">
          <div class="gallery-track gallery-track-right slow">
            {[...row2, ...row2].map((p, i) => (
              <div class={`gallery-item ${(i % row2.length) % 2 === 0 ? 'shift-up' : 'shift-down'}`}>
                <img src={p.src} alt={p.alt} />
                <span class="gallery-item-label">{p.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>


    <!-- CONTACT: Email + external links -->
    <section id="contact">
      <p class="section-tag reveal contact-tag"><span class="slide-from-right">Contact</span></p>
      <div class="contact-links reveal">
        <a href="mailto:plysuwana@gmail.com" class="contact-email">plysuwana@gmail.com</a>
        <a href="https://www.linkedin.com/in/plyfaa-murphy/" class="contact-link" target="_blank">
          <span>LinkedIn</span>
        </a>
        <a href="https://github.com/plyfaa" class="contact-link" target="_blank">
          <span>GitHub</span>
        </a>
        <a href="https://scholar.google.com/citations?user=TCRiqYcAAAAJ&hl=en" class="contact-link" target="_blank">
          <span>Google Scholar</span>
        </a>
        <a href="/cv.pdf" class="contact-link">
          <span>Curriculum Vitae</span>
        </a>
      </div>
    </section>

    <footer>
      <p class="footer-credit">
        Loosely designed in <a href="https://figma.com" class="footer-highlight" target="_blank">Figma</a> and coded in
        <a href="https://code.visualstudio.com" class="footer-highlight" target="_blank">Visual Studio Code</a> by yours truly. Built with
        <a href="https://astro.build" class="footer-highlight" target="_blank">Astro</a> and CSS,
        deployed with <a href="https://pages.github.com" class="footer-highlight" target="_blank">GitHub Pages</a>. All text is set in the
        <a href="https://www.figma.com/fonts/inter/" class="footer-highlight" target="_blank">Inter</a>,
        <a href="https://www.figma.com/fonts/playfair-display/" class="footer-highlight" target="_blank">Playfair Display</a>, and
        <a href="https://www.figma.com/fonts/dm-mono/" class="footer-highlight" target="_blank">DM Mono</a> typefaces.
      </p>
    </footer>

    <!-- RESEARCH DETAIL: Opens as full-page overlay -->
    <div class="research-modal-overlay" id="research-modal">
      <div class="research-modal">
        <button class="modal-close" id="modal-close" aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <div class="modal-content" id="modal-content">
          <!-- Dynamically populated by JS -->
        </div>
      </div>
    </div>

    <style is:global>
      /* ── DESIGN TOKENS ("this is my color") ── */
      :root {
        --bg:       #000000;
        --surface:  #141414;
        --border:   rgba(255,255,255,0.25);
        --blue:     #5B9BD5;
        --blue-dim: rgba(91,155,213,0.6);
        --text:     #FFFFFF;
        --mono:     'DM Mono', monospace;
        --serif:    'DM Mono', monospace;
        --sans:     'DM Mono', monospace;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--sans); background: var(--bg); color: var(--text); overflow-x: hidden; }
      @media (min-width: 1024px) { html { zoom: 0.85; } }

      /* ── NAV ── */
      nav {
        position: static; z-index: 100;
        display: flex; flex-direction: column; justify-content: flex-start; align-items: flex-start;
        gap: clamp(6px, 0.8vw, 12px);
        padding: clamp(12px, 2vw, 24px) clamp(60px, 12vw, 180px); border-bottom: none;
        background: transparent;
      }
      nav.scrolled { background: transparent; }
      .nav-status { font-family: var(--mono); font-size: clamp(9px, 0.85vw, 12px); color: rgba(255,255,255,0.7); letter-spacing: 1px; }
      .nav-status em { font-style: italic; }
      .nav-logo { font-family: var(--sans); font-size: clamp(11px, 1.1vw, 16px); color: var(--text); text-decoration: none; white-space: nowrap; }
      .nav-links { display: flex; gap: clamp(12px, 2.4vw, 32px); list-style: none; }
      .nav-links a { font-family: var(--sans); font-size: clamp(8px, 0.85vw, 12px); letter-spacing: 1.5px; color: var(--text); text-decoration: underline; text-underline-offset: 4px; transition: color 0.2s; white-space: nowrap; }
      .nav-links a:hover { color: var(--blue); }

      /* ── SECTION BASE ── */
      section { max-width: 1200px; margin-left: auto; margin-right: auto; padding: clamp(48px, 7vw, 90px) clamp(20px, 5vw, 64px); border-bottom: 1px solid var(--border); }
      .section-tag { font-family: var(--mono); font-size: clamp(11px, 1.1vw, 15px); letter-spacing: 4px; color: var(--text); margin-bottom: clamp(24px, 3.5vw, 48px); display: flex; align-items: center; gap: 16px; }
      /* removed the decorative blue line next to section headers */
      .section-tag::after { display: none; }

      /* ── ABOUT ── */
      #about {
        padding-top: clamp(80px, 10vw, 130px); padding-bottom: clamp(120px, 18vw, 240px);
        padding-left: clamp(60px, 12vw, 180px); padding-right: clamp(260px, 22vw, 380px);
        border-bottom: none; min-height: 100vh; position: relative; color: #1A1A18;
        display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
        max-width: none;
      }
      #about::before {
        content: ''; position: absolute; z-index: -2; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw;
        background: #F7F2E7;
      }
      #experiences, #gallery { border-bottom: none; }
      #gallery { padding-bottom: clamp(8px, 1vw, 16px); }
      .about-text-body { position: relative; width: 100%; max-width: 720px; margin: clamp(14px, 2vw, 24px) 0 0; perspective: 1000px; border: none; padding: 0; background: transparent; z-index: 2; }
      .bio-stack { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: clamp(8px, 1.2vw, 14px); z-index: 2; order: -1; }
      .speech-bubble { background: #FFFFFF; color: #000; padding: clamp(10px, 1.5vw, 16px) clamp(14px, 2.5vw, 22px); border-radius: 18px; position: relative; max-width: 320px; font-family: var(--sans); font-size: clamp(13px, 1.3vw, 18px); }
      .speech-bubble::after { content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); border-left: 10px solid transparent; border-right: 10px solid transparent; border-top: 10px solid #FFFFFF; }
      .about-text-body .about-body { transform-origin: top; opacity: 0; animation: heroFlipIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      .about-text-body .about-body:last-child { margin-bottom: 0; }
      .about-text-body .about-body:nth-of-type(1) { animation-delay: 0.4s; }
      .about-text-body .about-body:nth-of-type(2) { animation-delay: 0.9s; }
      .about-text-body .about-body:nth-of-type(3) { animation-delay: 1.4s; }
      @keyframes heroFlipIn {
        from { opacity: 0; transform: rotateX(-90deg); }
        to   { opacity: 1; transform: rotateX(0); }
      }
      @media (prefers-reduced-motion: reduce) {
        .about-text-body .about-body { opacity: 1; animation: none; }
      }
      .about-name { font-family: var(--serif); font-size: clamp(24px, 3vw, 40px); line-height: 1.3; color: #1A1A18; margin-bottom: clamp(20px, 3vw, 32px); }
      .about-name em { font-style: italic; color: var(--blue); }
      .about-body { font-size: clamp(11px, 0.95vw, 14px); font-weight: 300; color: #1A1A18; line-height: 1.7; margin-bottom: clamp(14px, 2vw, 24px); }
      .bio-photo-wrapper { position: relative; flex-shrink: 0; width: clamp(280px, 36vw, 480px); overflow: visible; }
      .about-photo { position: relative; z-index: 1; width: 100%; height: auto; object-fit: unset; object-position: center; border-radius: 0; display: block; transform: none; transition: transform 0.5s; }
      .bio-photo-block { display: flex; flex-direction: column; align-items: flex-start; width: clamp(280px, 36vw, 480px); }
      .hero-separator { order: -1; font-family: var(--mono); font-size: clamp(14px, 1.6vw, 22px); color: rgba(26,26,24,0.55); letter-spacing: 8px; margin: clamp(6px, 0.9vw, 12px) 0; text-align: center; line-height: 1; }
      .hero-design-bg { position: absolute; top: 0; bottom: 0; right: calc(50% - 50vw); width: clamp(180px, 22vw, 320px); z-index: -1; pointer-events: none; background-image: url('/hero_design_background.jpg'); background-repeat: repeat-y; background-size: 100% auto; }
      .section-separator { font-family: var(--mono); font-size: clamp(14px, 1.6vw, 22px); color: rgba(255,255,255,0.6); letter-spacing: 8px; text-align: center; padding: clamp(24px, 4vw, 48px) 0; }
      .bio-photo-caption { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: clamp(10px, 0.95vw, 13px); letter-spacing: 1px; color: #1A1A18; margin-top: 4px; }
      .bio-pin { font-size: 1.1em; line-height: 1; }
      .about-photo-label { font-family: var(--mono); font-size: clamp(8px, 0.8vw, 10px); letter-spacing: 2px; color: rgba(255,255,255,0.6); text-align: right; margin-top: 10px; }
      .about-highlight { color: var(--blue); text-decoration: none; transition: color 0.2s; }
      .about-highlight:hover { color: #1A1A18; }

      /* ── EXPERIENCES (ORBIT) ── */
      #experiences { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding-top: clamp(80px, 12vw, 160px); padding-bottom: clamp(80px, 12vw, 160px); background: #FFFFFF; color: #000000; position: relative; z-index: 0; }
      #experiences::before { content: ''; position: absolute; z-index: -1; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw; background: #FFFFFF; }
      #experiences .orbit-center { color: #000000; }
      #experiences .orbit-note { color: rgba(0,0,0,0.6); }
      #experiences .orbit-item { background: rgba(0,0,0,0.08); border-color: rgba(0,0,0,0.3); }
      .orbit-wrap { padding: clamp(16px, 2.5vw, 36px) 0; display: flex; justify-content: center; width: 100%; position: relative; perspective: 1400px; perspective-origin: center; }
      .orbit { position: relative; width: clamp(420px, 70vw, 820px); height: clamp(420px, 70vw, 820px); will-change: transform; }
      .orbit-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: var(--sans); font-size: clamp(28px, 4vw, 56px); color: var(--text); letter-spacing: 2px; pointer-events: none; }
      .orbit-note { position: absolute; top: calc(50% + clamp(28px, 4vw, 50px)); left: 50%; transform: translate(-50%, 0); font-family: var(--mono); font-size: clamp(11px, 1.1vw, 14px); color: rgba(255,255,255,0.6); letter-spacing: 1px; pointer-events: none; white-space: nowrap; }
      .orbit-item {
        position: absolute; top: 50%; left: 50%;
        width: clamp(110px, 15vw, 180px); height: clamp(110px, 15vw, 180px);
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.35);
        border-radius: 50%;
        transform: translate(-50%, -50%) rotate(var(--angle)) translateY(calc(-1 * clamp(140px, 23vw, 260px))) rotate(calc(-1 * var(--angle)));
      }
      @media (prefers-reduced-motion: reduce) { .orbit { transform: none !important; } }

      /* ── GALLERY ── */
      #gallery .section-tag { justify-content: center; text-align: center; font-size: clamp(22px, 3.8vw, 48px); letter-spacing: 2px; color: #FFFFFF; }
      #gallery .section-tag.reveal { opacity: 1; transform: none; }
      #gallery .section-tag .slide-from-left { display: inline-block; will-change: transform, opacity; opacity: 0; transform: translateY(40px); transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
      #gallery .section-tag .slide-from-left.risen { opacity: 1; transform: translateY(0); }
      .gallery-marquee { display: flex; flex-direction: column; gap: clamp(8px, 1vw, 16px); width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
      .gallery-row { overflow: hidden; cursor: grab; touch-action: pan-y; padding: clamp(16px, 2.5vw, 32px) 0; }
      .gallery-row.dragging { cursor: grabbing; }
      .gallery-track { display: flex; align-items: center; gap: clamp(8px, 1vw, 16px); width: max-content; will-change: transform; user-select: none; }
      .gallery-track img { -webkit-user-drag: none; user-drag: none; pointer-events: none; }
      .gallery-item { --shift: 0px; transform: translateY(var(--shift)); transform-origin: center center; }
      .gallery-item.shift-up   { --shift: clamp(-32px, -2.5vw, -16px); }
      .gallery-item.shift-down { --shift: clamp(16px, 2.5vw, 32px); }
      .gallery-item { flex-shrink: 0; width: clamp(200px, 26vw, 360px); aspect-ratio: 4/3; background: var(--surface); overflow: hidden; position: relative; }
      .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .gallery-item-label { position: absolute; bottom: 16px; left: 16px; font-family: var(--mono); font-size: clamp(7px, 0.8vw, 10px); letter-spacing: 2px; color: #FFFFFF; background: rgba(0,0,0,0.55); padding: 4px 10px; border-radius: 2px; }
      @media (prefers-reduced-motion: reduce) { .gallery-track { animation: none; } }


      /* ── CONTACT ── */
      #contact { min-height: auto; display: flex; flex-direction: column; align-items: center; text-align: center; gap: clamp(20px, 3vw, 40px); color: #1A1A18; position: relative; z-index: 0; padding-bottom: clamp(48px, 7vw, 90px); }
      #contact::before { content: ''; position: absolute; z-index: -2; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw;
        background:
          radial-gradient(ellipse 60% 65% at 50% 30%, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0) 70%),
          linear-gradient(125deg, #F7F2E7 0%, #FBF7EC 45%, #ECE3CF 100%);
      }
      #contact::after { content: ''; position: absolute; z-index: -1; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw; pointer-events: none; background: linear-gradient(110deg, transparent 0%, rgba(255,255,255,0.18) 38%, rgba(255,255,255,0.55) 50%, rgba(255,255,255,0.18) 62%, transparent 100%); }
      #contact .section-tag { color: #000000; font-size: clamp(22px, 3.8vw, 48px); letter-spacing: 2px; margin-bottom: 0; justify-content: center; text-align: center; }
      #contact .section-tag.reveal { opacity: 1; transform: none; }
      #contact .section-tag .slide-from-right { display: inline-block; will-change: transform, opacity; opacity: 0; transform: translateY(40px); transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
      #contact .section-tag .slide-from-right.risen { opacity: 1; transform: translateY(0); }
      #contact .contact-body { color: rgba(0,0,0,0.7); }
      #contact .contact-email { color: #000000; }
      #contact .contact-link { color: rgba(0,0,0,0.7); }
      #contact .contact-email:hover, #contact .contact-link:hover { color: #A8D8FF; }
      #contact .section-tag { justify-content: center; }
      .contact-body { font-size: clamp(13px, 1.2vw, 16px); font-weight: 300; color: rgba(255,255,255,0.75); line-height: 1.7; max-width: 480px; margin: 0; }
      .contact-email { font-family: var(--mono); font-size: clamp(11px, 1.05vw, 15px); letter-spacing: 1.6px; color: var(--text); text-decoration: none; display: inline-block; transition: color 0.25s ease, transform 0.25s ease; transform-origin: center; }
      .contact-email:hover { color: var(--blue); transform: scale(1.12); }
      .contact-links { display: flex; flex-direction: column; align-items: center; padding-top: 0; gap: clamp(10px, 1.6vw, 18px); }
      .contact-link { display: inline-flex; justify-content: center; align-items: center; gap: 12px; padding: 0; text-decoration: none; color: rgba(255,255,255,0.75); font-family: var(--mono); font-size: clamp(11px, 1.05vw, 15px); letter-spacing: 1.6px; transition: color 0.25s ease, transform 0.25s ease; transform-origin: center; }
      .contact-link:hover { color: var(--blue); transform: scale(1.12); }
      .contact-link-arrow { display: none; }

      /* ── FOOTER ── */
      footer { max-width: 1200px; margin: 0 auto; padding: clamp(24px, 3.5vw, 48px) clamp(20px, 5vw, 64px); display: flex; justify-content: space-between; align-items: start; border-top: 1px solid var(--border); }
      .footer-credit { font-size: clamp(11px, 1vw, 14px); letter-spacing: 0.5px; color: rgba(255,255,255,0.75); line-height: 1.8; max-width: 800px; }
      .footer-highlight { color: var(--blue); }
      a.footer-highlight { text-decoration: none; }
      a.footer-highlight:hover { color: var(--text); }

      /* ── RESEARCH MODAL ── */
      .research-modal-overlay {
        position: fixed; inset: 0; z-index: 200;
        background: rgba(0, 0, 0, 0.0); backdrop-filter: blur(0px);
        pointer-events: none; opacity: 0; overflow-y: auto;
        transition: background 0.4s ease, backdrop-filter 0.4s ease, opacity 0.4s ease;
      }
      .research-modal-overlay.open {
        opacity: 1; pointer-events: all;
        background: rgba(0, 0, 0, 0.92); backdrop-filter: blur(20px);
      }
      .research-modal {
        max-width: 860px; margin: 0 auto; padding: clamp(60px, 8vw, 100px) clamp(20px, 5vw, 64px) clamp(40px, 6vw, 80px);
        transform: translateY(40px); opacity: 0;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
      }
      .research-modal-overlay.open .research-modal { transform: translateY(0); opacity: 1; }
      .modal-close {
        position: fixed; top: clamp(16px, 2.5vw, 32px); right: clamp(20px, 3vw, 40px);
        background: none; border: none; color: var(--text);
        width: clamp(36px, 5vw, 48px); height: clamp(36px, 5vw, 48px);
        display: flex; align-items: center; justify-content: center;
        transition: color 0.2s; z-index: 201;
      }
      .modal-close:hover { color: var(--blue); }
      .modal-content .modal-tag { font-family: var(--mono); font-size: clamp(10px, 1vw, 14px); letter-spacing: 4px; color: var(--blue); display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
      /* hide line adjacent to modal tag */
      .modal-content .modal-tag::after { display: none; }
      .modal-content .modal-heading { font-family: var(--serif); font-size: clamp(22px, 2.7vw, 35px); color: var(--text); line-height: 1.15; margin-bottom: 16px; }
      .modal-content .modal-section-label { font-family: var(--mono); font-size: clamp(10px, 1vw, 14px); letter-spacing: 3px; color: var(--blue); margin-bottom: 16px; margin-top: 56px; }
      .modal-content .modal-body { font-size: clamp(13px, 1.1vw, 15px); font-weight: 300; color: rgba(255,255,255,0.75); line-height: 1.9; margin-bottom: 16px; max-width: 680px; }
      .modal-content .modal-image-grid img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border: 1px solid var(--border); border-radius: 2px; display: block; filter: grayscale(15%) brightness(0.9); transition: filter 0.4s; }
      .modal-body-grid { display: grid; grid-template-columns: 1fr 160px; gap: clamp(24px, 3.5vw, 48px); margin-top: 32px; }
      .modal-body-main { min-width: 0; }
      .modal-sidebar { border-left: 1px solid var(--border); padding-left: 24px; }
      .modal-sidebar-item { margin-bottom: 20px; }
      .modal-sidebar-label { display: block; font-family: var(--mono); font-size: clamp(10px, 1vw, 14px); letter-spacing: 2px; color: var(--blue-dim); margin-bottom: 4px; }
      .modal-sidebar-value { display: block; font-family: var(--mono); font-size: clamp(10px, 0.95vw, 13px); color: rgba(255,255,255,0.75); font-weight: 300; }
      .modal-file-list { display: flex; flex-direction: column; }
      .modal-file-item { display: flex; align-items: center; gap: 10px; padding: 14px 0; text-decoration: none; transition: background 0.2s; }
      .modal-file-icon { font-size: 30px; }
      .modal-file-name { font-family: var(--mono); font-size: clamp(11px, 1vw, 14px); letter-spacing: 1px; color: rgba(255,255,255,0.75); flex: 1; }
      .modal-file-open { font-family: var(--mono); font-size: 9px; letter-spacing: 2px; color: var(--blue); opacity: 0; transition: opacity 0.2s; }
      .modal-file-item:hover .modal-file-open { opacity: 1; }
      .modal-file-item:hover .modal-file-name { color: var(--text); }
      body.modal-open { overflow: hidden; }

      /* ── ANIMATIONS ── */
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
      .reveal.visible { opacity: 1; transform: none; }

      /* ── RESPONSIVE: SMALL LAPTOPS / TABLETS ── */
      @media (max-width: 900px) {
        /* Stack hero on tablets so photo + text box don't collide */
        .about-text-body { position: static; transform: none; width: 100%; max-width: 600px; margin: 0 auto; }
        .bio-stack { position: static; align-items: center; margin-top: clamp(24px, 4vw, 40px); }
        .bio-photo-wrapper { width: clamp(220px, 60vw, 360px); aspect-ratio: auto; }

        .about-text-body::before, .about-text-body::after { display: none; }

        .modal-body-grid { grid-template-columns: 1fr; }
        .modal-sidebar { border-left: none; padding-left: 0; border-top: 1px solid var(--border); padding-top: 24px; display: flex; flex-wrap: wrap; gap: 16px 32px; }
      }

      /* ── RESPONSIVE: PHONES ── */
      @media (max-width: 600px) {
        /* Disable custom cursor on touch devices */
        .cursor, .cursor-ring { display: none; }

        /* Mobile: stack normally — text on top, photo at bottom */
        .about-text-body { position: static; width: 100%; max-width: 100%; }
        .bio-stack { position: static; align-items: center; margin-top: clamp(20px, 4vw, 40px); }
        .bio-photo-wrapper { width: clamp(200px, 80vw, 320px); aspect-ratio: auto; }
        .about-text-body .about-body { background: #FFFFFF; color: rgba(0,0,0,0.85); padding: clamp(6px, 1.5vw, 10px) clamp(8px, 2vw, 14px); border-radius: 2px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
        .about-text-body .about-highlight { color: var(--blue); }

        .contact-links { padding-top: 0; }

        /* Modal sidebar stacks */
        .modal-body-grid { grid-template-columns: 1fr; }
        .modal-sidebar { border-left: none; padding-left: 0; border-top: 1px solid var(--border); padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px 24px; }

        /* Nav: shrink gap and logo size to prevent overlap */
        .nav-logo { font-size: 12px; }
        /* Nav: right-align wrapped links */
        .nav-links { gap: 8px 16px; flex-wrap: wrap; justify-content: flex-end; }
        .nav-links a { font-size: 10px; letter-spacing: 1px; }
      }

      /* ── RESPONSIVE: VERY SMALL PHONES ── */
      @media (max-width: 400px) {
        .nav-links { flex-wrap: wrap; gap: 8px 12px; justify-content: flex-end; }
      }
    </style>

    <script>
      // ── NAV ──────────────────────────────────────────────────
      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));

      // ── EXPERIENCES ORBIT: scroll-driven rotation + tilt ─────
      const orbit = document.getElementById('orbit');
      if (orbit) {
        const orbitContainer = orbit.parentElement;
        const updateOrbit = () => {
          const rect = orbitContainer.getBoundingClientRect();
          const vh = window.innerHeight;
          const progress = (vh - rect.top) / (vh + rect.height);
          const clamped = Math.max(0, Math.min(1, progress));
          // Z spin: 120° across full visible range (slower than before)
          const zRot = clamped * 120;
          // X tilt: starts at 70° (angled), eases to 0° by mid-scroll, stays facing
          const xRot = clamped < 0.5 ? 70 * (1 - clamped * 2) : 0;
          orbit.style.transform = `rotateX(${xRot}deg) rotate(${zRot}deg)`;
        };
        window.addEventListener('scroll', updateOrbit, { passive: true });
        window.addEventListener('resize', updateOrbit);
        updateOrbit();
      }

      // ── GALLERY + CONTACT TAGS: one-time rise-up on enter ───
      const riseObserver = new IntersectionObserver(entries => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            target.classList.add('risen');
            riseObserver.unobserve(target);
          }
        });
      }, { threshold: 0.2 });
      document.querySelectorAll('#gallery .slide-from-left, #contact .slide-from-right').forEach(el => riseObserver.observe(el));

      // ── GALLERY MARQUEE: auto-scroll + manual drag/wheel + click-to-enlarge ──────
      const setupMarquee = (trackSelector, direction) => {
        const track = document.querySelector(trackSelector);
        if (!track) return null;
        const row = track.parentElement;
        let offset = 0;
        let trackWidth = 0;
        let isDragging = false;
        let lastX = 0;
        let totalDragDist = 0;
        let velocity = 0;
        let paused = false;
        const autoSpeed = 0.4;

        const measure = () => { trackWidth = track.scrollWidth / 2; };
        measure();
        track.querySelectorAll('img').forEach(img => {
          if (!img.complete) img.addEventListener('load', measure, { once: true });
        });
        window.addEventListener('resize', measure);

        const wrap = () => {
          if (trackWidth <= 0) return;
          while (offset <= -trackWidth) offset += trackWidth;
          while (offset > 0) offset -= trackWidth;
        };

        const tick = () => {
          if (!isDragging && !paused) {
            offset += autoSpeed * direction + velocity;
            velocity *= 0.93;
            if (Math.abs(velocity) < 0.02) velocity = 0;
          }
          wrap();
          track.style.transform = `translateX(${offset}px)`;
          requestAnimationFrame(tick);
        };

        row.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          e.preventDefault();
          velocity -= e.deltaX * 0.15;
        }, { passive: false });

        const onDown = (clientX) => {
          isDragging = true;
          lastX = clientX;
          totalDragDist = 0;
          velocity = 0;
          row.classList.add('dragging');
        };
        const onMove = (clientX) => {
          if (!isDragging) return;
          const dx = clientX - lastX;
          offset += dx;
          velocity = dx;
          totalDragDist += Math.abs(dx);
          wrap();
          track.style.transform = `translateX(${offset}px)`;
          lastX = clientX;
        };
        const onUp = () => {
          if (!isDragging) return;
          isDragging = false;
          row.classList.remove('dragging');
        };

        row.addEventListener('mousedown', (e) => { e.preventDefault(); onDown(e.clientX); });
        window.addEventListener('mousemove', (e) => onMove(e.clientX));
        window.addEventListener('mouseup', onUp);
        row.addEventListener('touchstart', (e) => onDown(e.touches[0].clientX), { passive: true });
        row.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), { passive: true });
        row.addEventListener('touchend', onUp);
        row.addEventListener('touchcancel', onUp);

        const api = {
          pause: () => { paused = true; },
          resume: () => { paused = false; velocity = 0; },
        };
        requestAnimationFrame(tick);
        return api;
      };
      setupMarquee('.gallery-track-left', -1);
      setupMarquee('.gallery-track-right', 1);

      // ── SCROLL REVEAL ─────────────────────────────────────────
      const revealObserver = new IntersectionObserver(entries => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            target.classList.add('visible');
            revealObserver.unobserve(target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      // ── RESEARCH DETAIL MODAL (JS) ─────────────────────────────────
      const projectData = {
        'semantic-congruency': {
          tag: '',
          title: 'Semantic Congruency Effects on Visual Attention',
          sidebar: {},
          overview: `Visual search is an everyday activity where humans effectively integrate
          multiple sources of information to find relevant objects. Recent evidence
          shows that semantic congruency, how well an object fits within its scene
          context, drives overt attention. When viewing a scene, we rapidly extract its
          gist, which activates schemas encoding expectations about which objects are
          likely to appear. While much has been revealed about recognition of
          individual objects in isolation, the neural mechanisms underlying attention to
          congruent versus incongruent objects within naturalistic scenes remain poorly
          understood.`,
          methods: `Aim 1 develops an open-source dataset of ~450 scenes with systematically 
          graded congruency levels (low, medium, high). Aim 2 uses eye-tracking and EEG to 
          adjudicate between the facilitation and interference models explaining semantic 
          congruency effects on visual attention.`,
          files: [
            { name: 'NSF GRFP Research Proposal', path: 'https://drive.google.com/file/d/1wOT4NLdTZXYkIw26foogs5lxleW_BVvL/view?usp=sharing', type: 'pdf' },
          ],
        },
      };

      const modal = document.getElementById('research-modal');
      const modalContent = document.getElementById('modal-content');
      const modalClose = document.getElementById('modal-close');

      function openProject(projectId) {
        const data = projectData[projectId];
        if (!data) return;

        const s = data.sidebar;
        const sidebarItems = [
          { label: 'Institution', value: s.institution },
          { label: 'Advisor', value: s.advisor },
          { label: 'Duration', value: s.duration },
          { label: 'Funding', value: s.funding },
          { label: 'Funder', value: s.funder },
        ];

        const sidebarHTML = sidebarItems.filter(item => item.value).map(item => `
          <div class="modal-sidebar-item">
            <span class="modal-sidebar-label">${item.label}</span>
            <span class="modal-sidebar-value">${item.value}</span>
          </div>
        `).join('');

        const files = data.files?.filter(f => f.path) || [];
        const filesHTML = files.length > 0 ? `
          <p class="modal-section-label">Documents</p>
          <div class="modal-file-list">
            ${files.map(f => `
              <a href="${f.path}" target="_blank" class="modal-file-item">
                <span class="modal-file-icon">${f.type === 'pdf' ? '📄' : '🖼'}</span>
                <span class="modal-file-name">${f.name}</span>
                <span class="modal-file-open">Open →</span>
              </a>
            `).join('')}
          </div>
        ` : '';

        modalContent.innerHTML = `
          ${data.tag ? `<p class="modal-tag">${data.tag}</p>` : ''}
          <h2 class="modal-heading">${data.title}</h2>
          <div class="modal-body-grid">
            <div class="modal-body-main">
              <p class="modal-section-label">Overview</p>
              <p class="modal-body">${data.overview}</p>
              <p class="modal-section-label">Methods</p>
              <p class="modal-body">${data.methods}</p>
              ${filesHTML}
            </div>
            ${sidebarHTML ? `<div class="modal-sidebar">${sidebarHTML}</div>` : ''}
          </div>
        `;

        document.body.classList.add('modal-open');
        modal.classList.add('open');
      }

      function closeProject() {
        modal.classList.remove('open');
        document.body.classList.remove('modal-open');
      }

      document.querySelectorAll('.research-item[data-project]').forEach(item => {
        item.addEventListener('click', () => openProject(item.dataset.project));
        item.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openProject(item.dataset.project); }
        });
      });

      modalClose.addEventListener('click', closeProject);
      modal.addEventListener('click', e => { if (e.target === modal) closeProject(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeProject(); });
    </script>

  </body> 
</html>
