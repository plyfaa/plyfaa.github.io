      /* hint precedes the photo in the DOM, so reach it from the parent rather than a sibling combinator */
      .bio-photo-block:has(.bio-photo-wrapper:hover) .bio-photo-hint { opacity: 0; animation-play-state: paused; }
      @media (prefers-reduced-motion: reduce) { .bio-photo-hint { animation: none; } }
      @media (hover: none) { .bio-photo-hint { display: none; } }
      /* ── HOVER EASTER EGG: BLINKING EYES ──
         Anchors are percentages of the photo frame, measured off the source image, so they stay
         locked to her eyes at every width. .eye owns position + head tilt, .eye-lid owns the blink
         (they'd fight over `transform` on one element). */
      .eye {
        position: absolute; z-index: 3; width: 6.6%; aspect-ratio: 1 / 0.70;
        opacity: 0; transform: translate(-50%, -50%) rotate(22deg) scale(0.6);
        transition: opacity 0.14s ease, transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
        pointer-events: none;
      }
      .eye--l { left: 29.6%; top: 34.5%; }
      .eye--r { left: 37.5%; top: 37.0%; }
      .eye-lid { display: block; width: 100%; height: 100%; position: relative; }
      /* almond needs real points where the two curves meet — border-radius can only make
         ellipses or flat-edged rounded rects, so the lid outline is an SVG path */
      .eye-shape { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .eye-shape path { fill: #FFFDF8; stroke: #1A1A1A; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
      .eye-pupil {
        position: absolute; z-index: 2; left: 50%; top: 52%; width: 44%; aspect-ratio: 1;
        background: #1A1A1A; border-radius: 50%; transform: translate(-50%, -50%);
