---

<!-- Plyfaa Suwanamalik-Murphy -->

<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Plyfaa Suwanamalik-Murphy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet"/>
  </head>

  <body>

    <!-- NAV -->
    <nav id="nav">
      <div class="nav-logo">
        <a href="#about" class="nav-logo-name">Plyfaa Suwanamalik-Murphy <span class="nav-logo-tagline">~ Visual Perception &amp; Attention</span></a>
        <span class="nav-logo-thai-row">
          <span class="nav-logo-thai">ปลายฟ้า</span>
          <span class="nav-logo-phonetic">/ˈplaɪfɑː/</span>
          <button type="button" class="pronunciation-btn" id="pronunciation-btn" aria-label="Play pronunciation of Plyfaa">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          </button>
          <audio id="thai-name-audio" src="/name_pronunciation.m4a" preload="metadata"></audio>
        </span>
      </div>
      <div class="nav-icons" aria-label="Contact">
        <a href="mailto:plysuwana@gmail.com" aria-label="Email" class="nav-icon nav-icon--email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/plyfaa-murphy/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="nav-icon nav-icon--linkedin">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 3H3.55A.55.55 0 0 0 3 3.55v16.9c0 .3.25.55.55.55h16.9a.55.55 0 0 0 .55-.55V3.55A.55.55 0 0 0 20.45 3zM8.34 18.34H5.67V9.67h2.67v8.67zM7 8.5a1.55 1.55 0 1 1 0-3.1 1.55 1.55 0 0 1 0 3.1zm11.34 9.84h-2.67v-4.42c0-1.05-.02-2.4-1.46-2.4-1.46 0-1.69 1.14-1.69 2.32v4.5H9.86V9.67h2.56v1.18h.04c.36-.67 1.22-1.38 2.52-1.38 2.7 0 3.2 1.78 3.2 4.08v4.79z"/></svg>
        </a>
        <a href="https://github.com/plyfaa" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="nav-icon nav-icon--github">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.95-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.7.41.35.78 1.05.78 2.12 0 1.53-.01 2.77-.01 3.14 0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <a href="https://scholar.google.com/citations?user=TCRiqYcAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar" class="nav-icon nav-icon--scholar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.749-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
        </a>
        <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" aria-label="Curriculum Vitae" class="nav-icon nav-icon--with-text">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
          <span>CV</span>
        </a>
      </div>
      {/* <ul class="nav-links">
        <li><a href="#gallery">From the Lab</a></li>
      </ul> */}
    </nav>

    <!-- ABOUT: Bio + photo -->
    <section id="about">
<div class="about-text-body">
          <p class="about-body">
            I'm fascinated by the eyes and what they reveal about our perception.
          </p>
          <p class="about-body">
            I'm an incoming PhD student in
            <a href="https://bradylab.ucsd.edu" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Timothy Brady's Visual and Memory Lab</a> at
            <a href="https://ucsd.edu" class="about-highlight" target="_blank" rel="noopener noreferrer">UC San Diego</a>. Previously, I was a Research Fellow at the
            <a href="https://www.nih.gov" class="about-highlight" target="_blank" rel="noopener noreferrer">National Institutes of Health</a> in
            <a href="https://fim.nimh.nih.gov/" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Peter Bandettini's lab</a>, where I investigated how we can modulate
            our pupil size in real-time to regulate our perception and neural activity. I also built
            decoding pipelines for BCIs as a
            <a href="https://www.simonsfoundation.org" class="about-highlight" target="_blank" rel="noopener noreferrer">Simons Foundation Fellow</a> under
            <a href="https://neuroprosthetics.science/" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Sergey Stavisky</a>, and investigated visual perception at the
            <a href="https://www.psy.ox.ac.uk/" class="about-highlight" target="_blank" rel="noopener noreferrer">University of Oxford</a> advised by
            <a href="https://www.psy.ox.ac.uk/people/hannah-smithson" class="about-highlight" target="_blank" rel="noopener noreferrer">Dr. Hannah Smithson</a>.
          </p>
          <p class="about-body">
            I completed my Bachelor's in Cognitive Science from
            <a href="https://ucdavis.edu" class="about-highlight" target="_blank" rel="noopener noreferrer">UC Davis</a> in 2 years. And spent most of that time in
            research labs, learning as much as I could about eye-tracking, EEG, and visual cognition.
          </p>
      </div>
      <div class="bio-stack">
        <div class="bio-photo-block">
          <div class="bio-photo-wrapper">
            <img src="/hero_pic.jpeg" alt="Plyfaa Suwanamalik-Murphy" class="about-photo bio-photo"/>
          </div>
          <span class="bio-photo-caption"><span class="bio-pin">📍</span>Crete, Greece</span>
        </div>
      </div>
    </section>

{/* GALLERY: two scrolling rows. commented out for now
    <section id="gallery">
      <p class="section-tag reveal gallery-tag">From the Lab</p>
      <div class="gallery-marquee reveal">
